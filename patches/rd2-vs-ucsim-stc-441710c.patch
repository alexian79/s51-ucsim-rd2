+/*! \brief Bind the names of a `.sym' symbol table into the variable table.
+ *
+ * Names that already have a binding made by anything other than a symbol file
+ * keep it: the SFR and register names of the device are what
+ * `expression' and the disassembler print, and a firmware that happens to
+ * define a C identifier called `A' or `IE' must not silently move them.  A row
+ * that cannot be parsed is reported with its line number and stops the load, so
+ * that half a table is never mistaken for the whole one.
+ *
+ * \return number of names bound.
+ */
+long
+cl_uc::read_sym_file(cl_f *f, class cl_console_base *con)
+{
+  struct sym_load st;
+  st.con= con;
+  st.fname= f->get_file_name();
+  st.areas= new struct sym_area[sym_area_NR];
+  for (int i= 0; i < sym_area_NR; i++)
+    {
+      st.areas[i].seen= false;
+      st.areas[i].absolute= false;
+    }
+  st.rows= new cl_list(16, 32, "sym_rows");
+  st.section= sym_s_none;
+  st.line_nr= 1;
+  st.bad_line= 0;
+  st.bad_why= "";
+  st.undefined= 0;
+  st.unusable= 0;
+  st.out_of_range= 0;
+  st.relative= 0;
+  st.kept= 0;
+  st.kept_names= "";
+  st.range_names= "";
+
+  chars line= chars();
+  for (;;)
+    {
+      int c= f->get_c();
+      if (c <= 0 || f->eof())
+        break;
+      if (c == '\n')
+        {
+          sym_load_line(&st, line);
+          line= "";
+          st.line_nr++;
+          continue;
+        }
+      if (c != '\r')
+        line.append((char)c);
+    }
+  if (line.nempty())
+    sym_load_line(&st, line);
+
+  if (st.bad_line)
+    sym_say(con, chars("", "sym: %s:%ld: %s, nothing after it is loaded",
+                       st.fname ? st.fname : "?", st.bad_line,
+                       st.bad_why.c_str()));
+
+  long cnt= 0;
+  for (t_index i= 0; i < st.rows->count; i++)
+    {
+      struct sym_row *row= (struct sym_row *)st.rows->at(i);
+      const char *area= "";
+      if (row->area >= 0 && row->area < sym_area_NR && st.areas[row->area].seen)
+        {
+          area= st.areas[row->area].name.c_str();
+          if (st.areas[row->area].absolute)
+            row->relocatable= false;      // absolute area: the value is final
+        }
+      class cl_memory *m= sym_memory(area, row->addr);
+      if (!m ||
+          !m->is_address_space() ||
+          !m->valid_address(row->addr))
+        {
+          st.out_of_range++;
+          if (st.out_of_range <= 5)
+            {
+              if (st.range_names.nempty())
+                st.range_names+= ", ";
+              st.range_names+= row->name;
+            }
+          continue;
+        }
+      t_index vi;
+      if (vars->by_name.search(row->name.c_str(), vi))
+        {
+          class cl_cvar *v= vars->by_name.at(vi);
+          if (v && v->defined_by != VBY_DEBUG)
+            {
+              st.kept++;
+              if (st.kept <= 5)
+                {
+                  if (st.kept_names.nempty())
+                    st.kept_names+= ", ";
+                  st.kept_names+= row->name;
+                }
+              continue;
+            }
+        }
+      class cl_cvar *v= vars->add(row->name, m, row->addr, "");
+      v->set_by(VBY_DEBUG);
+      if (row->relocatable)
+        st.relative++;
+      cnt++;
+    }
+
+  if (st.kept)
+    sym_say(con, chars("", "sym: %ld name(s) already had a binding and kept it: %s%s",
+                       st.kept, st.kept_names.c_str(),
+                       st.kept > 5 ? ", ..." : ""));
+  if (st.undefined)
+    sym_say(con, chars("", "sym: %ld name(s) have no address: the assembler left them undefined",
+                       st.undefined));
+  if (st.out_of_range)
+    sym_say(con, chars("", "sym: %ld name(s) have no cell here: %s%s",
+                       st.out_of_range, st.range_names.c_str(),
+                       st.out_of_range > 5 ? ", ..." : ""));
+  if (st.relative)
+    sym_say(con, chars("", "sym: %ld name(s) are in relocatable areas: their value counts from the base of the area, which a .sym file does not record",
+                       st.relative));
+
+  for (t_index i= 0; i < st.rows->count; i++)
+    delete (struct sym_row *)st.rows->at(i);
+  st.rows->disconn_all();
+  delete st.rows;
+  delete[] st.areas;
+  return cnt;
+}
