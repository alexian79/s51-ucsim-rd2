+/*
+ * Which address space a symbol-file name lives in.
+ *
+ * SDCC and the ASxxxx assembler say what kind of object a symbol is by the
+ * NAME OF ITS AREA, never by its address: 0x30 is the instruction at code
+ * address 0x30 while it is in CSEG, and the byte called `counter' while it is
+ * in DSEG.  The areas the tool chain defines for the 8051 are a closed list,
+ * so the data ones are matched by name and anything else - including areas a
+ * hand-written assembly invents - is taken to be code, which is also what the
+ * `.cdb' and `.map' loaders assume.  A symbol with no area at all is an
+ * `.equ' or an absolute symbol and names a cell outright, so there the address
+ * itself says where it is.
+ *
+ * Symbols of the bit area (`.bit' variables) are not bound at all: they name a
+ * single bit and their value is a bit number, while the `bits' address space
+ * here is indexed by byte, so there is no cell to hand out.
+ */
+class cl_memory *
+cl_51core::sym_memory(const char *area, t_addr addr)
+{
+  static const char *const data_areas[]= {
+    "DSEG", "PSEG", "XSEG", "XISEG", "SSEG", "OSEG", "DATA", "INITIALIZED",
+    "REG_BANK", "GENOVER",
+    NULL
+  };
+  bool data= !(area && *area);
+
+  if (!data)
+    {
+      chars name= area;
+      name.uppercase();
+      while (name.c(0) == '_')
+        name.substr(1, name.len() - 1);
+      if (strstr(name.c_str(), "BSEG") != NULL)
+        return NULL;
+      for (int i= 0; data_areas[i] && !data; i++)
+        if (strstr(name.c_str(), data_areas[i]) != NULL)
+          data= true;
+      if (!data)
+        return rom;
+    }
+  if (addr <= 0x7f)
+    return iram;
+  if (addr <= 0xff)
+    return sfr;
+  if (xram && xram->valid_address(addr))
+    return xram;
+  return rom;
+}
