+
+/*
+ * Atmel AT89C51RD2 / AT89C51ED2 (doc4235).
+ *
+ * Electrically the part this model was written for.  The reason the class exists is
+ * the identity: -t 89C51RD2 selects CPU_89C51RD2 in the device table, which is what
+ * lets an RD2-only peripheral be registered in this constructor instead of in
+ * cl_uc89c51r::mk_hw_elements(), where it would also appear on the Atmel
+ * 89C51RB2/RC2 (SPI, keyboard, enhanced BRG, ENBOOT, POF are all missing there).
+ * The other thing it carries is the reset values of Table 3-11 that the family class
+ * does not share: they are overrides here, not gates on rd2_mem(), because
+ * rd2_mem() is true for the 89C51RB2/RC2 as well.
+ */
+class cl_uc89c51rd2: public cl_uc89c51r
+{
+public:
+  cl_uc89c51rd2(struct cpu_entry *Itype, class cl_sim *asim):
+    cl_uc89c51r(Itype, asim)
+    { boot_hw= 0; }
+  virtual void clear_sfr(void);
+
+  // The internal baud rate generator behind BRL/BDRCON (doc4235 figure 14-5) exists only
+  // on this part; the AT89C51RB2/RC2 has no BRG, so it is registered here instead of being
+  // gated in the family class.  cl_serial discovers it through new_hw_added() and only
+  // then do BDRCON and CKCON0.SIX2 mean anything, so no predicate is needed anywhere else.
+  virtual void mk_hw_elements(void);
+
+  // The 2048-byte boot ROM of this part (doc4235 Features p.1, table 8-1 p.21) and the
+  // Flash API its USER_CALL entry point dispatches (section 24.10 p.112).  The element
+  // registered by mk_hw_elements() owns the window and the command table; what has to
+  // happen on the instruction boundary -- noticing a fetch of FFF0h before the byte at
+  // FFF0h has been executed -- cannot live in a peripheral, so it lives here and keeps
+  // only the two lines the datasheet needs.  Null until mk_hw_elements() runs, and
+  // never set at all on the AT89C51RB2/RC2, which has no boot ROM: exec_inst() then
+  // costs one compare against 0 and the part executes exactly as it did.
+  virtual int exec_inst(void);
+
+  class cl_rd2_boot *boot_hw;
 };
 
 
