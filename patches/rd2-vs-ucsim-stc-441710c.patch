+/*
+ * The condition has to survive the trip to the evaluator.  A parameter the
+ * console has turned into a number carries no string value, so
+ * `break 0x3a if 0' ended up with an empty condition: the command had
+ * matched a branch legitimately (three parameters, `CELL STRING STRING', and
+ * a bare number is a cell) and had thrown the tail away, leaving an
+ * UNCONDITIONAL breakpoint whose condition had silently disappeared.  A
+ * keyword that was not `if' -- `break 0x3a hit 2', `break 0x3a iff x' -- was
+ * discarded the same way.  Both are refused now, and `hit' is honoured,
+ * since the usage line offers it.
+ */
+static bool
+cond_text(chars *cond, class cl_cmd_arg *arg, class cl_console_base *con)
+{
+  char *s= arg->get_svalue();
+
+  if (!s ||
+      !*s)
+    {
+      con->dd_printf("A condition has to be a word or a quoted string, not a\n"
+		     "bare number; nothing was created.\n");
+      return(false);
+    }
+  *cond= s;
+  return(true);
+}
