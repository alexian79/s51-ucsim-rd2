+/*
+ * SDAS (ASxxxx) symbol table: the `.sym' file
+ *
+ * SDCC writes this file from `lstsym()' in `sdas/asxxsrc/aslist.c' whenever
+ * the assembler is given its `-s' option (`sdas/asxxsrc/asmain.c':
+ * `if (sflag) tfp= afile(q, "sym", 1)' and, at the end of the assembly,
+ * `if (sflag) lstsym(tfp)').  It is a printout rather than a database and it
+ * has three parts: a banner line, a `Symbol Table' section and an `Area
+ * Table' section.  A symbol record is made of
+ *
+ *   " %2X "   area reference, or four spaces when the symbol has no area
+ *   "%-8.8s"  name (`%-60.60s' with the assembler's -w option)
+ *   '='       for an equated symbol, ' ' otherwise
+ *   "  %04X " value ("  **** " while the symbol is still undefined; wider for
+ *             targets with 3- and 4-byte addresses)
+ *   flags     'G' global, 'L' local, 'R' the symbol has an area, 'X' undefined
+ *
+ * and up to three records share one line separated by `|' unless -w puts each
+ * record on a line of its own.  Both the name column and the value column move
+ * with the assembler options and with the target's address width, so a record
+ * is taken apart from the right, where the fields are known, rather than from
+ * fixed columns.
+ *
+ * Area Table rows are `%3X %-8.8s   size %4X   flags %4X'.  The ABS bit of the
+ * flags (`A3_ABS', 010 octal, in `sdas/linksrc/aslink.h') tells whether the
+ * area was assembled absolute, i.e. whether the values inside it are final
+ * addresses.  A `.sym' of a relocatable build does NOT record where the linker
+ * put its areas, so such a symbol is bound at the offset printed in the file
+ * and counted for a warning: the linker's `.map' is the file that knows where
+ * an area landed.
+ */
+
+#define sym_area_NR 256
+/* A3_ABS in sdas/linksrc/aslink.h */
+#define sym_area_ABS 0x08
+/* width of the area-reference column of a symbol record */
+#define sym_area_field 4
+
+enum sym_section {
+  sym_s_none,
+  sym_s_symbols,
+  sym_s_areas
+};
+
+/*! \brief One row of the Symbol Table section; kept until the areas are known,
+ *  because the Area Table is printed after the symbols.
+ */
+struct sym_row
+{
+  chars name;
+  t_addr addr;
+  int area;                 // area reference, -1: the symbol has no area
+  bool relocatable;         // 'R': value counts from the base of the area
+  bool undefined;           // 'X', or a `****' value
+  long line;
+};
+
+/*! \brief One row of the Area Table section. */
+struct sym_area
+{
+  chars name;
+  bool seen;
+  bool absolute;
+};
+
+/*! \brief State of one `.sym' file while it is read. */
+struct sym_load
+{
+  class cl_console_base *con;
+  const char *fname;
+  struct sym_area *areas;
+  class cl_list *rows;
+  enum sym_section section;
+  long line_nr;
+  long bad_line;            // 0 while nothing has been refused
+  chars bad_why;
+  long undefined;           // `****' rows
+  long unusable;            // names the console could never type
+  long out_of_range;        // no such cell in the space we chose
+  long relative;            // bound at an area-relative value
+  long kept;                // name already bound by something else
+  chars kept_names;         // a few of those names for the summary
+  chars range_names;
+};
+
+
+static void
+sym_say(class cl_console_base *con, const chars &msg)
+{
+  if (con)
+    con->dd_printf("%s\n", msg.c_str());
+  else
+    printf("%s\n", msg.c_str());
+}
+
+
+static bool
+sym_flag_letter(char c)
+{
+  return c == 'G' || c == 'L' || c == 'R' || c == 'X';
+}
+
+
+/*! \brief Whether the line is the banner lstsym() repeats at every page.
+ *
+ * `chars' caches its length and its in-place truncators only write NULs, so
+ * every length here comes from strlen() of the (possibly truncated) buffer.
+ */
+static bool
+sym_banner_line(chars line)
+{
+  int l= strlen(line.c_str());
+  if (l < 1 || line.c(l - 1) != '.')
+    return false;
+  return strstr(line.c_str(), ", page ") != NULL;
+}
+
+
+/*! \brief Whether the token is a value lstsym() could have printed. */
+static bool
+sym_value_token(chars tok)
+{
+  int l= tok.len();
+  if (l != 4 && l != 6 && l != 8)
+    return false;
+  bool stars= tok.c(0) == '*';
+  for (int i= 0; i < l; i++)
+    {
+      char c= tok.c(i);
+      if ((c == '*') != stars)
+        return false;
+      if (!stars && !isxdigit(c))
+        return false;
+    }
+  return true;
+}
+
+
+/*! \brief Take one symbol record apart, working from the right.
+ *
+ * The record is parsed inside the buffer the `chars' object owns, truncating
+ * it with NULs, because rtrim(), rrip() and substr() of this `chars'
+ * implementation do not keep the cached length in step with what they remove
+ * and `len()' would report columns that are already gone.
+ *
+ * \return false when the record is not a symbol; `why' is only set when the
+ *         record is not merely the padding between two records.
+ */
+static bool
+sym_parse_row(chars seg, struct sym_row *row, chars *why)
+{
+  char *buf= seg.str();
+  int l;
+
+  l= strlen(buf);
+  while (l > 0 && isspace(buf[l - 1]))
+    l--;
+  buf[l]= 0;
+  if (l < 1)
+    return false;                         // the gap between two '|' records
+
+  // trailing one-letter flags: G global, L local, R relocatable, X undefined
+  int nflag= 0;
+  while (nflag < l && sym_flag_letter(buf[l - 1 - nflag]))
+    nflag++;
+  row->relocatable= false;
+  row->undefined= false;
+  for (int i= 0; i < nflag; i++)
+    {
+      if (buf[l - 1 - i] == 'R')
+        row->relocatable= true;
+      if (buf[l - 1 - i] == 'X')
+        row->undefined= true;
+    }
+  l-= nflag;
+  while (l > 0 && isspace(buf[l - 1]))
+    l--;
+  buf[l]= 0;
+
+  // value: the only column whose width lstsym() keeps fixed ("  %04X ", or
+  // " **** " when the assembler could not work out the address at all)
+  int v= 0;
+  while (v < l && (isxdigit(buf[l - 1 - v]) || buf[l - 1 - v] == '*'))
+    v++;
+  if (!v)
+    {
+      *why= chars("no address in the line");
+      return false;
+    }
+  chars val= buf + l - v;
+  l-= v;
+  while (l > 0 && isspace(buf[l - 1]))
+    l--;
+  buf[l]= 0;
+  if (!sym_value_token(val))
+    {
+      *why= chars("", "`%s' is not an address", val.c_str());
+      return false;
+    }
+
+  if (l > 0 && buf[l - 1] == '=')
+    {                                     // equate: '=' is not part of a name
+      l--;
+      buf[l]= 0;
+    }
+  if (l <= sym_area_field)
+    {
+      *why= chars("no name column");
+      return false;
+    }
+  chars name= buf + sym_area_field;      // copy before the separator is written
+  buf[sym_area_field]= 0;
+  chars area_field= buf;
+  area_field.trim();
+  name.trim();
+  if (name.empty())
+    {
+      *why= chars("name is empty");
+      return false;
+    }
+  row->name= name;
+  if (area_field.empty())
+    row->area= -1;                        // `.equ' and absolute symbols
+  else
+    {
+      const char *a= area_field.c_str();
+      for (int i= 0; a[i]; i++)
+        if (!isxdigit(a[i]))
+          {
+            *why= chars("", "area `%s' is not a hex area reference", a);
+            return false;
+          }
+      row->area= (int)area_field.htoi();
+    }
+  if (val.c(0) == '*')
+    row->undefined= true;
+  row->addr= row->undefined ? (t_addr)0 : (t_addr)val.htoi();
+  return true;
+}
+
+
+static void
+sym_load_symbol(struct sym_load *st, chars seg, long line_nr)
+{
+  struct sym_row row;
+  chars why= "";
+  if (!sym_parse_row(seg, &row, &why))
+    {
+      if (why.nempty())
+        {
+          st->bad_line= line_nr;
+          st->bad_why= why;
+        }
+      return;
+    }
+  if (row.undefined)
+    {
+      st->undefined++;
+      return;
+    }
+  if (!valid_sym_name(row.name.str()))
+    {
+      // bit names such as `ACC.0' cannot be typed at this console
+      st->unusable++;
+      return;
+    }
+  row.line= line_nr;
+  struct sym_row *r= new struct sym_row;
+  *r= row;
+  st->rows->add(r);
+}
+
+
+static void
+sym_load_area(struct sym_load *st, const chars &line)
+{
+  line.start_parse();
+  chars ref= line.token(" \t");
+  chars name= line.token(" \t");
+  chars kw1= line.token(" \t");
+  chars size= line.token(" \t");
+  chars kw2= line.token(" \t");
+  chars flags= line.token(" \t");
+  if (kw1 != "size" || kw2 != "flags" || ref.empty() || name.empty())
+    {
+      st->bad_line= st->line_nr;
+      st->bad_why= chars("not an area row");
+      return;
+    }
+  for (int i= 0; i < ref.len(); i++)
+    if (!isxdigit(ref.c(i)))
+      {
+        st->bad_line= st->line_nr;
+        st->bad_why= chars("", "area number `%s' is not hex", ref.c_str());
+        return;
+      }
+  int nr= (int)ref.htoi();
+  if (nr >= sym_area_NR)
+    return;
+  st->areas[nr].name= name;
+  st->areas[nr].seen= true;
+  st->areas[nr].absolute= (flags.htoi() & sym_area_ABS) != 0;
+  (void)size;
+}
+
+
+static void
+sym_load_line(struct sym_load *st, chars line)
+{
+  if (st->bad_line)
+    return;                               // a refused row ends the file
+  long line_nr= st->line_nr;
+  /* the record columns are fixed width and the first one is often blank, so
+     the line is split as it stands; only the headings are trimmed */
+  chars raw= line;
+  line.trim();
+  if (line.empty())
+    return;
+  if (sym_banner_line(line))
+    return;
+  if (line == "Symbol Table")
+    {
+      st->section= sym_s_symbols;
+      return;
+    }
+  if (line == "Area Table")
+    {
+      st->section= sym_s_areas;
+      return;
+    }
+  if (st->section == sym_s_none)
+    return;                               // version lines and comments
+  if (st->section == sym_s_areas)
+    {
+      sym_load_area(st, line);
+      return;
+    }
+  int l= strlen(raw.c_str());
+  int start= 0;
+  for (int i= 0; i <= l; i++)
+    {
