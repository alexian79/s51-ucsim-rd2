diff --git a/ucsim/src/sims/s51.src/rd2_boot.cc b/ucsim/src/sims/s51.src/rd2_boot.cc
new file mode 100644
index 0000000..b570676
--- /dev/null
+++ b/ucsim/src/sims/s51.src/rd2_boot.cc
@@ -0,0 +1,426 @@
+/*
+ * Simulator of microcontrollers (rd2_boot.cc)
+ *
+ * The boot ROM, the AUXR1.ENBOOT window and the on-chip Flash API (IAP) of the
+ * AT89C51RD2/ED2.  Every behaviour decision below cites the page of doc4235K it
+ * comes from; the file-level reasoning -- including what is deliberately not
+ * modelled -- is in rd2_bootcl.h.
+ *
+ * Copyright (C) 2026 Oleksiy <alexian79@gmail.com>
+ * GPL-2.0-or-later
+ */
+
+#include <stdio.h>
+
+#include "rd2_bootcl.h"
+#include "regs51.h"
+#include "uc51cl.h"
+
+
+/*
+ * Erase geometry of the array (table 24-9, printed p. 111, and the ERASE BLOCK row of
+ * table 24-10, printed p. 112).  The five blocks are deliberately unequal -- two of
+ * 8K and three of 16K, the last two running to the top of the address space -- so the
+ * selector is a lookup, never a division of 64K by 5.  The selector is DPH, and DPH
+ * happens to be the high address byte of the block it names, which is what makes the
+ * API's encoding readable.
+ */
+struct boot_block
+{
+  t_addr start;
+  t_addr end;
+  t_mem sel;                             /* the DPH value table 24-10 lists */
+};
+
+static const struct boot_block flash_blocks[5]=
+{
+  { 0x0000, 0x1fff, 0x00 },              /* Erase block0 (0000h-1FFFh) */
+  { 0x2000, 0x3fff, 0x20 },              /* Erase block1 (2000h-3FFFh) */
+  { 0x4000, 0x7fff, 0x40 },              /* Erase block2 (4000h-7FFFh) */
+  { 0x8000, 0xbfff, 0x80 },              /* Erase block3 (8000h-BFFFh) */
+  { 0xc000, 0xffff, 0xc0 }               /* Erase block4 (C000h-FFFFh) */
+};
+
+/* A Flash page, for the range check of PROGRAM DATA PAGE (section 24, printed p. 93:
+   "64K bytes of program memory organized respectively in 512 pages of 128 bytes"). */
+#define FLASH_PAGE  0x80
+
+
+/*
+ * Diagnostics.
+ *
+ * A refusal has to reach the person running the simulation, so it goes to stderr the
+ * way every other runtime complaint in this model does (pca.cc, port.cc).  It is not
+ * printed with con->dd_printf because there is no console on the call stack when the
+ * core steps: `go` owns it, and a dd_printf from inside exec_inst would interleave
+ * with the trace.  The counters that `info hardware boot` prints are the persistent
+ * record of the same events.
+ */
+static void
+boot_say(const char *what)
+{
+  fprintf(stderr, "boot: %s\n", what);
+  fflush(stderr);
+}
+
+
+cl_rd2_boot::cl_rd2_boot(class cl_uc *auc):
+  cl_hw(auc, HW_TIMER /* reuse category, as cl_rd2_spi and cl_rd2_kbd do */,
+        RD2_BOOT_ID, "boot")
+{
+  rom_space= 0;
+  boot_chip= 0;
+  flash_chip= 0;
+  cell_auxr1= 0;
+  enboot_banker= 0;
+  n_calls= 0;
+  n_refused= 0;
+  n_written= 0;
+  n_erased= 0;
+  last_cmd= 0;
+  last_result= "no USER_CALL yet";
+}
+
+
+/*
+ * The window, in the machinery the model already uses for every other banked window:
+ * one cl_banker on the `rom` address space, switched by AUXR1.ENBOOT, with bank 0
+ * pointing at the flash array and bank 1 at the boot ROM.  It is built here rather
+ * than in cl_uc89c51r::decode_rom() because the 89C51RB2/RC2 shares that function and
+ * has no boot ROM at all (Features, printed p. 1, lists the 2048-byte Boot ROM for the
+ * RD2/ED2 family this model was written for; doc4316 has no such block).
+ *
+ * Both banks have to be installed: cl_banker::activate() re-decodes the window cells
+ * itself, so the flat 0-0FFFFh mapping decode_rom() laid down is overridden for
+ * F800h-FFFFh while this element exists, and bank 0 restores exactly the flash bytes
+ * that mapping would have answered -- which is why clearing ENBOOT has to leave the
+ * same content behind, and why the suite can assert a before/after pair at one address.
+ */
+int
+cl_rd2_boot::init(void)
+{
+  class cl_address_space *sfr_space;
+
+  /* cl_hw::init() first: it sets on and creates the boot16_cfg var group. */
+  cl_hw::init();
+  sfr_space= uc->address_space(MEM_SFR_ID);
+  rom_space= uc->address_space(MEM_ROM_ID);
+  if (!sfr_space || !rom_space)
+    {
+      fprintf(stderr, "No rom/sfr space to map the boot ROM into\n");
+      return 1;
+    }
+  /* The array the API programs is the array the core fetches from: rom_chip is the
+     64K flash of section 24 (printed p. 93), and section 24.2 method 2 (printed p. 93)
+     is precisely "programmed or erased in the end-user application by calling
+     low-level routines through a common entry point in the Boot ROM". */
+  flash_chip= (class cl_memory_chip *)uc->memory("rom_chip");
+  if (!flash_chip)
+    {
+      fprintf(stderr, "No flash array to program through USER_CALL\n");
+      return 1;
+    }
+  /* The boot ROM itself.  Its content is NOT modelled -- the binary is not published
+     in doc4235K -- so the chip holds the erased value, which is what an unprogrammed
+     array answers and, unlike a pattern of our own invention, cannot be mistaken for
+     loader code by a test that dumps the window. */
+  boot_chip= new cl_chip8("boot_rom_chip", boot_size, 8, erased);
+  boot_chip->init();
+  uc->memchips->add(boot_chip);
+
+  cell_auxr1= sfr_space->get_cell(AUXR1);
+  enboot_banker= new cl_banker(sfr_space, AUXR1, bmENBOOT,
+                               rom_space, boot_base, boot_base + boot_size - 1);
+  enboot_banker->init();               /* allocates the 2 banks, hooks AUXR1 writes */
+  rom_space->decoders->add(enboot_banker);
+  enboot_banker->add_bank(0, flash_chip, boot_base);
+  enboot_banker->add_bank(1, boot_chip, 0);
+  enboot_banker->activate(0);
+  return 0;
+}
+
+
+void
+cl_rd2_boot::reset(void)
+{
+  /* ENBOOT after a reset is not a plain constant: figure 24-5 (printed p. 101) brings
+     the part up with "If BLJB = 0 then ENBOOT Bit (AUXR1) is Set else ENBOOT Bit
+     (AUXR1) is Cleared", and BLJB is a fuse (table 24-3, printed p. 95) the model does
+     not read, which is why Table 3-11 leaves AUXR1.5 as X and cl_uc89c51rd2::clear_sfr
+     brings it up cleared.  Whatever the register ends up at, the mapping has to agree
+     with it: clear_sfr writes AUXR1 with write(), which notifies the banker, and this
+     call covers a reset path that used set() instead.  The array and the boot ROM keep
+     their content across a reset -- flash does, and the boot ROM is masked. */
+  if (enboot_banker)
+    enboot_banker->activate(0);
+}
+
+
+bool
+cl_rd2_boot::enabled(void)
+{
+  return(cell_auxr1 && (cell_auxr1->get() & bmENBOOT) != 0);
+}
+
+
+/*
+ * DPTR0 (n=0) and DPTR1 (n=1) as the API sees them, i.e. independently of
+ * AUXR1.DPS.  The RD2's two pointers live in two banks of dptr_chip (uc51.cc,
+ * decode_dptr: the multi-DPTR chip style banks the DPL/DPH window onto dptr_chip at
+ * bank*2), so reading the chip answers for the idle pointer too -- which matters here
+ * because table 24-10 names DPTR0 and DPTR1 specifically while DPS belongs to the
+ * application.
+ */
+t_mem
+cl_rd2_boot::dptr_value(int n)
+{
+  class cl_memory *chip= uc->memory("dptr_chip");
+
+  if (chip)
+    return((chip->read(n * 2 + 1) << 8) | (chip->read(n * 2) & 0xff));
+  /* Parts without the dual-DPTR chip have one DPTR, in the SFRs.  Reachable only if
+     the family class stops building dptr_chip; DPTR1 then reads as DPTR0 rather than
+     silently as zero. */
+  {
+    class cl_51core *uc51= (class cl_51core *)uc;
+
+    return((uc51->sfr->read(DPH) << 8) | (uc51->sfr->read(DPL) & 0xff));
+  }
+}
+
+
+void
+cl_rd2_boot::refuse(void)
+{
+  char msg[256];
+
+  /* Section 24.10.1 (printed p. 112): "Before jump at the USER_CALL, the bit ENBOOT
+     in AUXR1 register must be set."  With the bit clear the boot ROM is not mapped at
+     all (table 8-1, printed p. 21), so the hardware would fetch whatever the flash
+     array holds at FFF0h -- the caller is in for a surprise either way, and the API
+     must not pretend to have run.  Hence: count it, name it, and let the uc class
+     execute the fetched byte. */
+  n_refused++;
+  last_result= "refused: ENBOOT clear";
+  sprintf(msg, "USER_CALL at %04xh refused: AUXR1=0x%02x has ENBOOT clear, so the boot"
+               " ROM is not mapped over %04xh-%04xh (table 8-1 p.21, section 24.10.1"
+               " p.112); fetching from the flash array instead",
+          (unsigned)entry_addr, (unsigned)(cell_auxr1 ? cell_auxr1->get() : 0),
+          (unsigned)boot_base, (unsigned)(boot_base + boot_size - 1));
+  boot_say(msg);
+}
+
+
+/*
+ * The body of USER_CALL: table 24-10 (printed pp. 112-113) read one row at a time.
+ * R1 selects the command, ACC/DPTR0/DPTR1 carry the arguments, and the value the row
+ * lists under "Returned Value" is written back to ACC.  A row that lists no returned
+ * value leaves ACC alone -- that is the difference between "the API answered" and "we
+ * felt like clearing the accumulator", and the suite pins both readings with
+ * distinguishable seeds.
+ *
+ * Nothing here burns machine cycles.  DECISION (SIMULATION-PLAN.md Phase 5 item 16):
+ * PROGRAM and ERASE return immediately, they do NOT stall for tWRITE = 7-17 ms
+ * (table 25-7, printed p. 115).  Three reasons, in order of weight:
+ *
+ *   - The table has a Min and a Max and the Typ column for tWRITE is EMPTY, so any
+ *     single delay is invented; and the boot ROM binary is unavailable, so the cycles
+ *     the real loader spends between the call and its RET cannot be attributed either.
+ *   - 7 ms at 24 MHz is 14000 machine cycles, 17 ms is 34000 (6 clocks per cycle with
+ *     CKCON0.X2: 28000 and 68000; 408000-1020000 oscillator periods either way).  A
+ *     stall of that size inside one instruction would corrupt every timing leg in the
+ *     tree -- UART and SPI bit measurements, PCA and timer counts, watchdog periods --
+ *     none of which the flash is involved in.
+ *   - A bootloader test that depends on the delay would then pass because the model
+ *     slept, not because the part behaved, which is the failure mode the plan warns
+ *     about.  The array is updated, the cycles are not, and the policy is printed by
+ *     `info hardware boot` so it cannot be forgotten at the next read of the code.
+ *
+ * If a future suite needs the stall, the honest place to add it is a per-command cost
+ * taken from a published tWRITE profile, not a constant here.
+ */
+void
+cl_rd2_boot::user_call(void)
+{
+  class cl_51core *uc51= (class cl_51core *)uc;
+  t_mem cmd= uc51->R[1]->get();
+  t_mem acc= uc51->acc->get();
+  t_mem dptr0= dptr_value(0);
+  t_mem dptr1= dptr_value(1);
+  char msg[256];
+
+  n_calls++;
+  last_cmd= cmd;
+
+  switch (cmd)
+    {
+      /* READ MANUF ID / READ DEVICE ID1 / ID2 / ID3, R1=00h with DPTR0 = 0000h..0003h
+         (table 24-10, printed p. 112).  The four values are the copies of the
+         identification bytes in table 24-3 (printed pp. 95-96); they are constants of
+         the part, so there is nothing to store.  An unlisted DPTR0 has no documented
+         answer, and an erased byte is the only honest one. */
+    case cmd_read_id:
+      switch (dptr0 & 0xffff)
+        {
+        case 0x0000: acc= id_manufacturer; last_result= "READ MANUF ID"; break;
+        case 0x0001: acc= id_device1;      last_result= "READ DEVICE ID1"; break;
+        case 0x0002: acc= id_device2;      last_result= "READ DEVICE ID2"; break;
+        case 0x0003: acc= id_device3;      last_result= "READ DEVICE ID3"; break;
+        default:
+          acc= erased;
+          last_result= "READ ID: undocumented DPTR0";
+          sprintf(msg, "READ ID with DPTR0=%04xh, which table 24-10 p.112 does not"
+                       " list; ACC left erased", (unsigned)dptr0);
+          boot_say(msg);
+          break;
+        }
+      break;
+
+      /* ERASE BLOCK, R1=01h, DPH selects the block, returned value ACC = DPH
+         (table 24-10, printed p. 112; geometry table 24-9, printed p. 111).  Erased
+         means 1s: table 24-2 (printed p. 95) defines P as "Programmed or zero level"
+         against U as "Unprogrammed or one level", so an erased byte reads 0xff.  There
+         is no chip erase in this API -- 07h Full Chip Erase belongs to the serial ISP
+         command set of table 24-9 (printed p. 111, "needs about 6 sec") -- so wiping
+         the array means erasing the five blocks one at a time. */
+    case cmd_erase_block:
+      {
+        t_mem dph= (dptr0 >> 8) & 0xff;
+        int i;
+
+        for (i= 0; i < 5; i++)
+          if (dph == flash_blocks[i].sel)
+            {
+              t_addr a;
+              unsigned long n= 0;
+
+              for (a= flash_blocks[i].start; a <= flash_blocks[i].end; a++)
+                {
+                  flash_chip->write(a, erased);
+                  n++;
+                }
+              n_erased+= n;
+              last_result= "ERASE BLOCK";
+              acc= dph;                  /* "ACC = DPH" */
+              write_acc(acc);
+              return;
+            }
+        last_result= "ERASE BLOCK: bad DPH";
+        sprintf(msg, "ERASE BLOCK with DPH=%02xh, which is not one of 00/20/40/80/C0"
+                     " of table 24-10 p.112; no block erased", (unsigned)dph);
+        boot_say(msg);
+        acc= dph;                        /* the row's returned value stands anyway */
+      }
+      break;
+
+      /* PROGRAM DATA BYTE, R1=02h, A = value, DPTR0 = address, returned value
+         ACC = 0: DONE (table 24-10, printed p. 112).  Section 24.2 (printed p. 93):
+         "It is not necessary to erase a byte or a page before programming.  The
+         programming of a byte or a page includes a self erase before programming."
+         So the byte lands as written, and the model must not AND it into the previous
+         content -- that would be the wear-only model of a device that has no self
+         erase, and it would make a program-over-different-data leg fail for a reason
+         the part does not have. */
+    case cmd_program_byte:
+      flash_chip->write(dptr0 & 0xffff, acc & 0xff);
+      n_written++;
+      last_result= "PROGRAM DATA BYTE";
+      acc= 0;                            /* "ACC = 0: DONE" */
+      break;
+
+      /* PROGRAM DATA PAGE, R1=09h, A = number of bytes, DPTR0 = first flash address,
+         DPTR1 = address in XRAM of the first data byte, returned value ACC = 0: DONE.
+         "Program up to 128 bytes in user Flash.  Remark: number of bytes to program is
+         limited such as the Flash write remains in a single 128 bytes page.  Hence,
+         when ACC is 128, valid values of DPL are 00h, or, 80h." (table 24-10, printed
+         p. 113).  The source is read through the MOVX space, so the XRS window of
+         section 9 is honoured for the source operand exactly as it is for the
+         application's own MOVX. */
+    case cmd_program_page:
+      {
+        unsigned int n= acc & 0xff;
+        t_addr fa= dptr0 & 0xffff;
+        t_addr sa= dptr1 & 0xffff;
+        unsigned int i;
+
+        if (n > FLASH_PAGE || (unsigned)(fa & (FLASH_PAGE - 1)) + n > FLASH_PAGE)
+          {
+            last_result= "PROGRAM DATA PAGE: crosses a page";
+            sprintf(msg, "PROGRAM DATA PAGE of %u bytes at %04xh would leave the"
+                         " 128-byte page the API is limited to (table 24-10 p.113);"
+                         " nothing programmed", n, (unsigned)fa);
+            boot_say(msg);
+            return;                      /* ACC untouched: no DONE was reached */
+          }
+        for (i= 0; i < n; i++)
+          {
+            flash_chip->write((fa + i) & 0xffff,
+                              uc51->xram->read((sa + i) & 0xffff) & 0xff);
+            n_written++;
+          }
+        last_result= "PROGRAM DATA PAGE";
+        acc= 0;                          /* "ACC = 0: DONE" */
+      }
+      break;
+
+      /* Commands of table 24-10 whose state this model does not have: 05h/06h/07h
+         write and read SSB/BSB/SBV (the software security bytes of section 24.8.1,
+         printed p. 103, which are monotonic and cleared only by a Full Chip Erase the
+         API cannot perform), 0Ah the BLJB/X2 fuses, 0Bh the hardware status byte,
+         0Eh/0Fh the boot ID and version, whose values doc4235K does not give.  They
+         are named, refused and left out of scope rather than answered with a number
+         that would look like a read. */
+    default:
+      last_result= "command not implemented";
+      sprintf(msg, "USER_CALL command %02xh in R1 is not implemented (table 24-10"
+                   " pp.112-113); ACC left unchanged", (unsigned)cmd);
+      boot_say(msg);
+      return;                            /* no returned value: ACC stays as it was */
+    }
+
+  write_acc(acc);
+}
+
+
+/*
+ * Writing the accumulator through the sfr space rather than the raw cell, so a read of
+ * ACC afterwards takes the same path the application's own `MOV A,#0` would.
+ */
+void
+cl_rd2_boot::write_acc(t_mem val)
+{
+  class cl_51core *uc51= (class cl_51core *)uc;
+
+  uc51->sfr->write(ACC, val & 0xff);
+}
+
+
+void
+cl_rd2_boot::print_info(class cl_console_base *con)
+{
+  t_mem a= (cell_auxr1 ? cell_auxr1->get() : 0);
+
+  /* Everything here is read with get(), never through a hook, and nothing here moves
+     the mapping: `info hardware boot` must not be able to change the state it reports.
+     DPS is printed alongside ENBOOT because both live in AUXR1 (table 8-1, printed
+     p. 21) and a wrong mask on either bit shows up as the other's failure. */
+  con->dd_printf("boot[%d] %s AUXR1=0x%02x ENBOOT=%d DPS=%d window=%04x-%04x (%d B)"
+                 " -> %s\n",
+                 id, on ? "on" : "off", (unsigned)a,
+                 (a & bmENBOOT) ? 1 : 0, (int)(a & 1),
+                 (unsigned)boot_base, (unsigned)(boot_base + boot_size - 1),
+                 (int)boot_size,
+                 enabled() ? "boot_rom_chip" : "rom_chip(flash)");
+  con->dd_printf("USER_CALL=%04x calls=%lu refused=%lu bytes_written=%lu"
+                 " bytes_erased=%lu last=%02x \"%s\"\n",
+                 (unsigned)entry_addr, n_calls, n_refused, n_written, n_erased,
+                 (unsigned)last_cmd, last_result);
+  con->dd_printf("boot ROM content not modelled (no binary in doc4235K): %d bytes of"
+                 " %02xh\n", (int)boot_size, erased);
+  con->dd_printf("tWRITE=0 cycles: PROGRAM/ERASE return instantly by decision"
+                 " (7-17 ms, table 25-7 p.115, has no typical value) -- see"
+                 " t/bootrom-report.md\n");
+}
+
+
+/* End of s51.src/rd2_boot.cc */
diff --git a/ucsim/src/sims/s51.src/rd2_bootcl.h b/ucsim/src/sims/s51.src/rd2_bootcl.h
new file mode 100644
index 0000000..c022c8f
--- /dev/null
+++ b/ucsim/src/sims/s51.src/rd2_bootcl.h
@@ -0,0 +1,133 @@
+/*
+ * AT89C51RD2/ED2 boot ROM, AUXR1.ENBOOT and the on-chip Flash API (IAP) -- doc4235K
+ * section 24 (printed pp. 92-113) plus table 8-1 (printed p. 21).
+ *
+ * Two things live here, and they are the two halves of one mechanism:
+ *
+ * 1) The 2048-byte boot ROM and the window AUXR1.ENBOOT maps it into.  Table 8-1
+ *    (printed p. 21) is the only place the window is stated numerically: ENBOOT
+ *    (bit 5, "Enable Boot Flash") is "Cleared to disable boot ROM.  Set to map the
+ *    boot ROM between F800h - 0FFFFh."  Both ends and the size therefore come from
+ *    that one row; it is corroborated by Features (printed p. 1, "2048 Bytes Boot
+ *    ROM Contains Low Level Flash Programming Routines and a Default Serial
+ *    Bootloader") and by table 24-1 (printed p. 94), which gives F800h as the boot
+ *    address when the BLJB fuse is 0.  It is program memory, not a data window: the
+ *    row says "map the boot ROM", the section it lives in calls the array "64K bytes
+ *    of program memory" (section 24, printed p. 93) and MOVX has its own space
+ *    (section 9), so the mapping is installed on the `rom` address space, which the
+ *    instruction fetch and MOVC both read and MOVX never touches.
+ *
+ * 2) USER_CALL, "the address FFF0h" through which "All calls are made" (section
+ *    24.10.1, printed p. 112), and the table 24-10 (printed pp. 112-113) dispatch
+ *    the boot ROM performs there: R1 selects the command, ACC/DPTR0/DPTR1 carry the
+ *    arguments, and the routine returns with the RET the caller relied on ("The jump
+ *    at the USER_CALL must be done by LCALL instruction to be able to comeback in
+ *    the application", printed p. 112).  "Before jump at the USER_CALL, the bit
+ *    ENBOOT in AUXR1 register must be set", so a call with ENBOOT clear is refused.
+ *
+ * What the boot ROM *contains* is NOT modelled: the binary is not published in
+ * doc4235K, so the chip is filled with 0xff (the erased state, which decodes as
+ * `MOV A,#0ff` / `ADD A,#0ff` sequences and is what an unprogrammed part would
+ * answer).  What IS modelled is the API the datasheet documents, which is what any
+ * test of "is the boot ROM reachable" has to observe.  Likewise out: the security
+ * bytes BSB/SBV/SSB (commands 05h/06h/07h, section 24.8.1 printed p. 103 -- levels
+ * 1 and 2 forbid the read, so they would have to be modelled as state before the
+ * reads could answer honestly), the fuse writes (0Ah), HSB (0Bh), the boot ID/version
+ * reads (0Eh/0Fh, whose values are not in the document), the serial bootloader
+ * protocol (section 24.9) and a host-side backing file for the programmed array.
+ *
+ * Timing is NOT modelled either, by decision rather than by omission: tWRITE is
+ * 7-17 ms (table 25-7, printed p. 115) but the table gives no typical value, and a
+ * fabricated stall of that size (14000-34000 machine cycles at 24 MHz) would corrupt
+ * every timing measurement in the tree for a delay no test can pin down.  See the
+ * comment at the point of decision in rd2_boot.cc and t/bootrom-report.md.
+ *
+ * Copyright (C) 2026 Oleksiy <alexian79@gmail.com>
+ * GPL-2.0-or-later
+ */
+
+#ifndef RD2_BOOTCL_HEADER
+#define RD2_BOOTCL_HEADER
+
+#include "hwcl.h"
+
+/* cl_hw ids in the HW_TIMER category are a bus other peripherals switch on, so the
+   id has to be free against every pair this part registers -- not just the dispatch
+   list in serial.cc, which only ever sees what it looks for.  Taken from the headers:
+   1, 2, 3 and 12 (timers, serial.cc), 10 (cl_stc12_adc), 11 (cl_stc12_wdt), 13
+   (rd2_brgcl.h), 14 (rd2_kbdcl.h) and 15 (rd2_spiccl.h, which was 14 there until the
+   collision with the keyboard was fixed at integration -- exactly the bug that made
+   `get_hw(HW_TIMER,14,0)` ambiguous and invisible to every suite, because `info hw`
+   resolves by name).  The boot ROM takes the next free one, 16, and nothing informs
+   it: it has no clock and no pin. */
+#define RD2_BOOT_ID 16
+
+class cl_memory_chip;
+class cl_banker;
+
+class cl_rd2_boot: public cl_hw
+{
+protected:
+  class cl_address_space *rom_space;     /* "rom": program memory, fetch + MOVC */
+  class cl_memory_chip *boot_chip;       /* the 2048 B boot ROM, table 8-1 p.21 */
+  class cl_memory_chip *flash_chip;      /* rom_chip: the 64K array, section 24 p.93 */
+  class cl_memory_cell *cell_auxr1;      /* AUXR1 (0xa2): ENBOOT bit5, DPS bit0 */
+  class cl_banker *enboot_banker;        /* who re-decodes F800h-FFFFh */
+
+  unsigned long n_calls;                 /* USER_CALL entries taken */
+  unsigned long n_refused;               /* entries refused for want of ENBOOT */
+  unsigned long n_written;               /* bytes written to the array by PROGRAM */
+  unsigned long n_erased;                /* bytes cleared by ERASE BLOCK */
+  t_mem last_cmd;                        /* R1 of the last entry, for `info hw` */
+  const char *last_result;               /* what the last entry did */
+
+  /* DPTR0 (n=0) and DPTR1 (n=1) as table 24-10 names them, i.e. independently of
+     AUXR1.DPS: both pointers live in banks of the model's dptr_chip. */
+  t_mem dptr_value(int n);
+  void write_acc(t_mem val);             /* the "Returned Value" column reaches ACC */
+
+public:
+  enum {
+    boot_base  = 0xf800,                 /* table 8-1, printed p.21 */
+    boot_size  = 0x800,                  /* 2048 B, printed p.1 */
+    entry_addr = 0xfff0,                 /* section 24.10.1, printed p.112 */
+    erased     = 0xff,                   /* erased Flash reads 1s (table 24-2 p.95) */
+
+    /* table 24-10, printed pp. 112-113.  There is no READ command and no ERASE PAGE
+       command in it: reading the array is MOVC ("Byte-wise read without wait state",
+       section 24.1 printed p. 93) and "ERASE" occurs on exactly one page of the whole
+       document -- the ERASE BLOCK row of this same table. */
+    cmd_read_id       = 0x00,
+    cmd_erase_block   = 0x01,
+    cmd_program_byte  = 0x02,
+    cmd_program_page  = 0x09,
+
+    /* table 24-3 "Default Values", printed pp. 95-96: the copies of the JEDEC-style
+       identification the READ MANUF ID / ID1 / ID2 / ID3 commands return. */
+    id_manufacturer   = 0x58,            /* Atmel */
+    id_device1        = 0xd7,            /* C51 X2, Electrically Erasable */
+    id_device2        = 0xec,            /* AT89C51RD2/ED2 64KB */
+    id_device3        = 0xef             /* AT89C51RD2/ED2 64KB, Revision 0 */
+  };
+
+  cl_rd2_boot(class cl_uc *auc);
+  virtual int init(void);
+  virtual void reset(void);
+  virtual void print_info(class cl_console_base *con);
+
+  /* AUXR1.ENBOOT as it stands.  get(), not read(): printing and dispatch must not
+     consume anything, and nothing hooks this cell for reading anyway. */
+  bool enabled(void);
+
+  /* The body of the boot ROM's entry point.  Reads R1/ACC/DPTR0/DPTR1, mutates the
+     Flash array, writes the returned value to ACC; the caller performs the RET. */
+  void user_call(void);
+
+  /* A USER_CALL that arrived with ENBOOT clear: counted and diagnosed, and the
+     caller falls through to whatever the flash array holds at FFF0h. */
+  void refuse(void);
+
+};
+
+#endif
+/* End of s51.src/rd2_bootcl.h */
diff --git a/ucsim/src/sims/s51.src/rd2_brg.cc b/ucsim/src/sims/s51.src/rd2_brg.cc
new file mode 100644
index 0000000..dccc979
--- /dev/null
+++ b/ucsim/src/sims/s51.src/rd2_brg.cc
@@ -0,0 +1,147 @@
+/*
+ * Simulator of microcontrollers (rd2_brg.cc)
+ *
+ * AT89C51RD2/ED2 internal Baud Rate Generator; see rd2_brgcl.h for the feature summary.
+ *
+ * Copyright (C) 2026 Oleksiy <alexian79@gmail.com>
+ * GPL-2.0-or-later
+ */
+
+#include "rd2_brgcl.h"
+#include "regs51.h"
+#include "uc89c51rcl.h"
+
+
+cl_rd2_brg::cl_rd2_brg(class cl_uc *auc):
+  cl_hw(auc, HW_TIMER, RD2_BRG_ID, "brg")
+{
+  cell_brl= 0;
+  cell_bdrcon= 0;
+  counter= 0;
+  prescaler= 0;
+  overflows= 0;
+  running= false;
+}
+
+int
+cl_rd2_brg::init(void)
+{
+  /* cl_hw::init() first: it sets on, creates the cfg space and registers brg13_on.
+     cl_stc12_brt, whose shape this module follows, never calls it, which is a defect of its
+     own; cl_stc12_adc is the one to copy. */
+  cl_hw::init();
+  class cl_address_space *sfr= uc->address_space(MEM_SFR_ID);
+  if (sfr)
+    {
+      /* BRL is only read by the model, so a plain cell is enough; BDRCON is the control
+         register and is registered the way cl_stc12_brt registers AUXR.  Nothing is cached
+         except BRR (see reset()), so no other SFR value can go stale under `reset brg`. */
+      cell_brl= sfr->get_cell(BRL);
+      cell_bdrcon= register_cell(sfr, BDRCON);
+    }
+  /* Name the registers for the console (dump sfr, print sfr, var).  They are not added to
+     sfr_tab51 the way CKCON0 is, because that table is keyed purely by CPU type: the widest
+     flag the family class answers to is CPU_89C51R, which also covers the AT89C51RB2/RC2,
+     and that part has no BRG.  Naming them here keeps the name and the peripheral appearing
+     and disappearing together.  Same var idiom as cl_51core::set_sfr_names (uc51.cc). */
+  if (sfr && uc->vars)
+    {
+      uc->vars->add("BRL", sfr, BRL, 7, 0, "Baud rate generator reload value");
+      uc->vars->add("BDRCON", sfr, BDRCON, 7, 0,
+                    "BRR:3 TBCK:2 RBCK:1 SPD:0 SRC");
+    }
+  /* The serial port is the only consumer.  It decides per direction whether an overflow is
+     the baud clock (BDRCON.TBCK/RBCK/SRC) and owns the /32, halved by PCON.SMOD1. */
+  make_partner(HW_UART, 0);
+  return 0;
+}
+
+/*
+ * The counter runs on FCLK_PERIPH/6^(1-SPD).  FCLK_PERIPH is Fosc/2 in standard mode and Fosc
+ * with CKCON0.X2 set, while a machine cycle is Fosc/12 and Fosc/6, so both clock states give
+ * fclk_periph_per_cycle() counts per machine cycle -- six, i.e. one count per cycle with SPD
+ * cleared and six with the /6 bypassed.  X2 cancels, which is why this generator has no
+ * CKCON0 bit of its own and why peripheral_cycles() must not be applied to it.
+ */
+int
+cl_rd2_brg::tick(int cycles)
+{
+  t_mem bdrcon;
+  int step, counts, i;
+
+  if (!cell_bdrcon || !cell_brl)
+    return resGO;
+  bdrcon= cell_bdrcon->get();
+  if (!(bdrcon & bmBRR))
+    {
+      /* BRR cleared: the BRG stops, and it must not keep the phase it accumulated while it
+         was supposed to be stopped.  doc4235 does not say what the counter holds between a
+         stop and the next start; dropping the remainder and restarting from BRL is the only
+         reading under which "Cleared to stop the internal Baud Rate Generator" can be
+         observed as never overflowing. */
+      running= false;
+      counter= 0;
+      prescaler= 0;
+      return resGO;
+    }
+  if (!running)
+    {
+      /* First cycle after the gate opens: begin a full period from BRL. */
+      running= true;
+      prescaler= 0;
+      counter= (unsigned char)(cell_brl->get() & 0xff);
+    }
+  prescaler+= cycles * ((cl_uc89c51r *)uc)->fclk_periph_per_cycle();
+  step= (bdrcon & bmSPD) ? 1 : 6;
+  counts= prescaler / step;
+  if (counts <= 0)
+    return resGO;
+  prescaler-= counts * step;
+  /* Writing BRL while the BRG runs is not specified in doc4235; the reload is read per
+     overflow, so a new value takes effect on the next wrap. */
+  for (i= 0; i < counts; i++)
+    {
+      counter++;                      /* the 8-bit wrap is the overflow */
+      if (counter == 0)
+	{
+	  counter= (unsigned char)(cell_brl->get() & 0xff);
+	  overflows++;
+	  inform_partners(EV_OVERFLOW, 0);
+	}
+    }
+  return resGO;
+}
+
+/*
+ * hw elements are reset before the SFRs are cleared (cl_51core::reset calls cl_uc::reset,
+ * which walks hws, and only then clear_sfr), so the cached BRR cannot be read back from
+ * BDRCON here: it comes from the register's reset constants, BDRCON = XXX0 0000b (doc4235
+ * table 14-13), i.e. stopped.  The rest is not derived from an SFR and is zeroed, which also
+ * keeps a standalone `reset brg` self-sufficient.
+ */
+void
+cl_rd2_brg::reset(void)
+{
+  counter= 0;
+  prescaler= 0;
+  overflows= 0;
+  running= false;
+}
+
+void
+cl_rd2_brg::print_info(class cl_console_base *con)
+{
+  t_mem bdrcon= cell_bdrcon ? (cell_bdrcon->get() & 0xff) : 0;
+  t_mem brl= cell_brl ? (cell_brl->get() & 0xff) : 0;
+
+  con->dd_printf("brg[%d] %s, BRL=0x%02x (%d counts), %s, TBCK=%d RBCK=%d SRC=%d\n",
+		 id, (bdrcon & bmBRR) ? "RUNNING" : "stopped", (unsigned)brl,
+		 256 - (int)brl, (bdrcon & bmSPD) ? "FAST" : "SLOW",
+		 (bdrcon & bmTBCK) ? 1 : 0, (bdrcon & bmRBCK) ? 1 : 0,
+		 (bdrcon & bmSRC) ? 1 : 0);
+  con->dd_printf("counter=0x%02x published_overflows=%lu\n",
+		 (unsigned)counter, overflows);
+}
+
+
+/* End of s51.src/rd2_brg.cc */
diff --git a/ucsim/src/sims/s51.src/rd2_brgcl.h b/ucsim/src/sims/s51.src/rd2_brgcl.h
new file mode 100644
index 0000000..0fbad8d
--- /dev/null
+++ b/ucsim/src/sims/s51.src/rd2_brgcl.h
@@ -0,0 +1,51 @@
+/*
+ * AT89C51RD2/ED2 internal Baud Rate Generator (BRG) — 8-bit self-reloading counter on
+ * FCLK_PERIPH, feeding the enhanced UART's baud clock.
+ *
+ * BRL (0x9a) holds the reload value and reloads itself; software never reloads it.
+ * BDRCON (0x9b) carries the run gate (BRR), the per-direction selects for the UART
+ * (TBCK/RBCK, which make TCLK/RCLK don't care), the /6 bypass (SPD) and the mode 0
+ * clock select (SRC, consumed by the serial model, not here).
+ *
+ * The clock the counter sees is FCLK_PERIPH/6^(1-SPD), i.e. one count per machine cycle
+ * with SPD cleared and six with it set, in both clock states -- see the derivation on
+ * cl_uc89c51r::fclk_periph_per_cycle().  X2 therefore cancels, which is the whole reason
+ * the divisor is expressed against FCLK_PERIPH: doc4235 CKRL (section 6) prescales
+ * FCLK_PERIPH itself and has to slow the PCA and the BRG with one change.
+ *
+ * Overflow is published to the UART as EV_OVERFLOW, exactly like cl_stc12_brt does; the
+ * serial model owns the /32 (halved by PCON.SMOD1) and the TBCK/RBCK/SRC routing.
+ *
+ * Copyright (C) 2026 Oleksiy <alexian79@gmail.com>
+ * GPL-2.0-or-later
+ */
+
+#ifndef RD2_BRGCL_HEADER
+#define RD2_BRGCL_HEADER
+
+#include "hwcl.h"
+
+/* cl_hw ids are a per-category bus that other peripherals switch on
+   (serial.cc:366-397 dispatches on 1, 2, 3 and 12); 13 is the BRG's. */
+#define RD2_BRG_ID 13
+
+class cl_rd2_brg: public cl_hw
+{
+protected:
+  class cl_memory_cell *cell_brl;      /* BRL (0x9a): reload, read only for us */
+  class cl_memory_cell *cell_bdrcon;   /* BDRCON (0x9b): run gate and /6 bypass */
+  unsigned char counter;               /* the BRG itself, reloaded on overflow */
+  int prescaler;                       /* FCLK_PERIPH remainder, in machine cycles */
+  unsigned long overflows;             /* published overflows, for `info hardware` */
+  bool running;                        /* last seen BRR; the only cached SFR bit */
+public:
+  cl_rd2_brg(class cl_uc *auc);
+  virtual int init(void);
+  virtual int tick(int cycles);
+  virtual void reset(void);
+  virtual void print_info(class cl_console_base *con);
+};
+
+#endif
+
+/* End of s51.src/rd2_brgcl.h */
diff --git a/ucsim/src/sims/s51.src/rd2_eeprom.cc b/ucsim/src/sims/s51.src/rd2_eeprom.cc
new file mode 100644
index 0000000..471e7d1
--- /dev/null
+++ b/ucsim/src/sims/s51.src/rd2_eeprom.cc
@@ -0,0 +1,262 @@
+/*
+ * Simulator of microcontrollers (rd2_eeprom.cc)
+ *
+ * AT89C51ED2 on-chip 2048-byte data EEPROM; see rd2_eepromcl.h for the feature summary,
+ * the datasheet answers it is built from (doc4235K section 23 printed pp.89-92, table 23-1
+ * printed p.91, table 25-2 printed p.115) and the decisions on persistence, tWRITE and the
+ * XRAM collision.  All page numbers are PRINTED pages.
+ *
+ * Copyright (C) 2026 Oleksiy <alexian79@gmail.com>
+ * GPL-2.0-or-later
+ */
+
+#include <string.h>
+
+#include "rd2_eepromcl.h"
+#include "regs51.h"
+#include "uc89c51rcl.h"
+
+
+cl_rd2_eeprom::cl_rd2_eeprom(class cl_uc *auc):
+  cl_hw(auc, HW_TIMER /* reuse category, as cl_rd2_spi and cl_rd2_boot do */,
+        RD2_EE_ID, "eeprom")
+{
+  cell_eecon= 0;
+  xram= 0;
+  /* An erased EEPROM reads all ones, which is also the state the bootloader's blank check
+     reports for unwritten bytes (section 24.8.2, printed p.103: full chip erase "fills with
+     FFh").  doc4235 nowhere states the shipped contents of the *data* block, so this is a
+     declared convention, and it is the one the erase statement above implies; it is pinned
+     by t/eepromtest.py so that changing it cannot be silent.  reset() deliberately does NOT
+     touch the array, so this runs once per process, not once per reset. */
+  memset(array, 0xff, sizeof(array));
+  reset();
+}
+
+int
+cl_rd2_eeprom::init(void)
+{
+  class cl_address_space *sfr;
+  t_addr a;
+
+  /* cl_hw::init() first: it sets on, creates the cfg space and registers eeprom17_on. */
+  cl_hw::init();
+  sfr= uc->address_space(MEM_SFR_ID);
+  if (sfr)
+    /* Registered, not merely fetched: bit 0 is hardware-owned ("Can not be set or cleared by
+       software", table 23-1, printed p.91), so every write to EECON has to be corrected on
+       its way in, and only a hook is on that path.  EECON is already named for the console
+       by sfr_tab51 (uc51.cc, gated on CPU_89C51RD2), so nothing is added to vars here and
+       `dump sfr` on the AT89C51RD2 keeps its transcript. */
+    cell_eecon= register_cell(sfr, EECON);
+  /* The overlay.  Every cell of the window gets this element as a memory operator, which is
+     what lets the decision be per-access: with EEE cleared the operator returns the cell
+     unchanged, so the XRAM/external-bus mapping cl_uc89c51r::decode_xram() built (AUXR.EXTRAM
+     and AUXR.XRS2:XRS0 banked, per page) is exactly what the CPU sees, and the AT89C51RD2 --
+     which never builds this element at all -- is untouched by construction.  A decoder or a
+     second cl_banker on EECON was the alternative and was rejected: the seven per-page
+     bankers of decode_xram() already own 0000h..06FFh, decoders in one space are
+     mutually exclusive rather than stackable, and the mapping underneath EEE is not a fixed
+     chip but a function of AUXR, so there is nothing to bank *to*. */
+  xram= uc->address_space(MEM_XRAM_ID);
+  if (xram)
+    for (a= 0; a < RD2_EE_SIZE; a++)
+      xram->register_hw(a, this, false);
+  return 0;
+}
+
+bool
+cl_rd2_eeprom::in_window(class cl_memory_cell *cell, t_addr *addr)
+{
+  return(xram && xram->is_owned(cell, addr) && *addr <= RD2_EE_LAST);
+}
+
+bool
+cl_rd2_eeprom::mapped(void)
+{
+  return(cell_eecon && (cell_eecon->get() & bmEEE) != 0);
+}
+
+/*
+ * tWRITE expressed in oscillator clocks at the frequency the part is running at, so the
+ * window is 17 ms of *time* and not 17 ms divided by whatever a machine cycle happens to be
+ * worth: CKRL and CKCON0.X2 both change the value of a cycle (section 6.2.1, printed p.16),
+ * neither changes a millisecond.  clocks_of_time() is `t * xtal`, so a DC setting -- which
+ * doc4235 section 1 allows, "down to any value, including DC" -- gives 0 clocks and the cycle
+ * finishes at the next tick instead of never.
+ */
+double
+cl_rd2_eeprom::cycle_clocks(void)
+{
+  return(double)(uc->clocks_of_time(RD2_EE_TWRITE_SEC));
+}
+
+void
+cl_rd2_eeprom::start_cycle(t_addr addr, t_mem val)
+{
+  busy= true;
+  pend_addr= addr;
+  pend_val= (unsigned char)(val & 0xff);
+  elapsed= 0;
+  busy_clocks= cycle_clocks();
+  /* Raise the flag in the register as well as in the element: nothing else writes the EECON
+     cell once the MOVX has landed, so without this EEBUSY would be state the console cannot
+     see and a guest could never poll.  set() and not write() for the same reason end_cycle()
+     uses it -- write() would come back through this element's own hook, whose job is to force
+     bit 0 to `busy`, and it would also let a program that clears EEE mid-cycle (which the
+     recommended sequence of section 23.1 does after the MOVX) take the flag away with it. */
+  if (cell_eecon)
+    cell_eecon->set(cell_eecon->get() | bmEEBUSY);
+}
+
+/*
+ * The commit point.  Section 23.1 says EEBUSY "indicate[s] that programming is in progress
+ * and that the EEPROM segment is not available for reading or writing", so the byte the
+ * program wrote must not be visible before the flag clears: it lands in the array here, and
+ * the flag is cleared with set() rather than write() for the same reason start_cycle() sets
+ * it that way.
+ */
+void
+cl_rd2_eeprom::end_cycle(void)
+{
+  if (pend_addr < RD2_EE_SIZE)
+    array[pend_addr]= pend_val;
+  busy= false;
+  pend_addr= 0;
+  pend_val= 0xff;
+  elapsed= 0;
+  n_bytes++;
+  n_cycles++;
+  if (cell_eecon)
+    cell_eecon->set(cell_eecon->get() & ~bmEEBUSY);
+}
+
+/*
+ * One call per machine cycle (cl_uc::tick_hw ticks every element with 1).  clock_per_cycle()
+ * is the whole reason the arithmetic stays integral: it is the machine cycle measured in
+ * oscillator clocks, X2 state and CKRL divider already folded in, so what accumulates here
+ * is the same clock count `state` reports as "clks".
+ */
+int
+cl_rd2_eeprom::tick(int cycles)
+{
+  if (!busy)
+    return resGO;
+  elapsed+= (unsigned long)(cycles * uc->clock_per_cycle());
+  if (elapsed >= (unsigned long)busy_clocks)
+    end_cycle();
+  return resGO;
+}
+
+/*
+ * MOVX reads of 0000h..07FFh.  Anything that is not the overlay -- EEE clear, an outside
+ * address, the cfg cell, and (defensively) a cell this element does not own -- is answered by
+ * falling through to the cell or to cl_hw::read(), which is what keeps a plain RD2-style read
+ * byte-identical: cl_hw_operator::read() ends up at cl_memory_operator::read(), i.e.
+ * cell->get(), which is the decoded byte of whichever chip decode_xram() selected.
+ */
+t_mem
+cl_rd2_eeprom::read(class cl_memory_cell *cell)
+{
+  t_addr addr;
+
+  if (cell == cell_eecon)
+    return cell->get();
+  if (!in_window(cell, &addr))
+    return cl_hw::read(cell);
+  if (!mapped())
+    return cell->get();
+  if (busy)
+    {
+      /* "not available for reading": the datasheet gives no value, so the model answers the
+	 level an EEPROM cell rests at -- 0xff -- and counts it.  The count is what makes the
+	 window observable from the console even to a guest that never checks the flag. */
+      n_blk_rd++;
+      return 0xff;
+    }
+  return array[addr];
+}
+
+/*
+ * MOVX writes.  Two cases end here without the cell seeing the value, and both of them say so
+ * by leaving *val at whatever the cell already holds: cl_memory_cell::write() stores whatever
+ * the last hook leaves in it, so assigning the current byte back is how a write is swallowed
+ * without moving anything.
+ *
+ *  - EEBUSY in a write to EECON: forced to the model's state, which is what "can not be set
+ *    or cleared by software" has to mean for a simulator.  Note this does not make EECON bit 0
+ *    read-only in general: `rd2registers` still finds the register writable where it should be.
+ *  - a write to the window with EEE set: the byte belongs to the array, not to the XRAM cell
+ *    underneath, so the XRAM byte must not move.  t/eepromtest.py pins both directions of that
+ *    with the same two addresses seeded with two different values.
+ */
+void
+cl_rd2_eeprom::write(class cl_memory_cell *cell, t_mem *val)
+{
+  t_addr addr;
+
+  if (cell == cell_eecon)
+    {
+      *val= (*val & ~bmEEBUSY) | (busy ? bmEEBUSY : 0);
+      return;
+    }
+  if (!in_window(cell, &addr))
+    {
+      cl_hw::write(cell, val);
+      return;
+    }
+  if (!mapped())
+    return;
+  if (busy)
+    {
+      /* Refused, not queued: there is one array and one byte may be in flight through it. */
+      n_blk_wr++;
+      *val= cell->get();
+      return;
+    }
+  start_cycle(addr, *val);
+  *val= cell->get();
+}
+
+/*
+ * The volatile state comes back; the array does not.  hw elements are reset before the SFRs
+ * are cleared (cl_51core::reset -> cl_uc::reset walks hws, then clear_sfr), so the cold state
+ * is taken from the register's reset constants -- EECON xxxx xx00b, table 3-11 printed p.7,
+ * i.e. unprogrammed and unmapped -- never read back from the cell, and the array is left
+ * exactly as it is because a data EEPROM is what the application keeps its parameters in
+ * across a reset.  There is deliberately no console path that erases it either: the silicon
+ * has none, only ISP "Program EEPROM data" and a parallel-mode full chip erase (section 24.8.2,
+ * printed p.103), neither of which this model has.  Counters clear with the rest, as in
+ * cl_rd2_brg and cl_rd2_spi.
+ */
+void
+cl_rd2_eeprom::reset(void)
+{
+  busy= false;
+  pend_addr= 0;
+  pend_val= 0xff;
+  elapsed= 0;
+  busy_clocks= 0;
+  n_bytes= 0;
+  n_cycles= 0;
+  n_blk_rd= 0;
+  n_blk_wr= 0;
+}
+
+void
+cl_rd2_eeprom::print_info(class cl_console_base *con)
+{
+  t_mem eecon= cell_eecon ? (cell_eecon->get() & 0xff) : 0;
+
+  con->dd_printf("eeprom[%d] %s, EECON=0x%02x EEE=%d EEBUSY=%d window=0x0000..0x%04x\n",
+		 id, busy ? "PROGRAMMING" : "idle", (unsigned)eecon,
+		 (eecon & bmEEE) ? 1 : 0, (eecon & bmEEBUSY) ? 1 : 0, (unsigned)RD2_EE_LAST);
+  con->dd_printf("tWRITE=%ld clks, elapsed=%lu pending=0x%04x:0x%02x frequency=%.6g MHz\n",
+		 (long)busy_clocks, elapsed, (unsigned)pend_addr, (unsigned)pend_val,
+		 uc->get_xtal() / 1e6);
+  con->dd_printf("bytes=%lu program_events=%lu blocked_reads=%lu blocked_writes=%lu\n",
+		 n_bytes, n_cycles, n_blk_rd, n_blk_wr);
+}
+
+
+/* End of s51.src/rd2_eeprom.cc */
diff --git a/ucsim/src/sims/s51.src/rd2_eepromcl.h b/ucsim/src/sims/s51.src/rd2_eepromcl.h
new file mode 100644
index 0000000..0d54a92
--- /dev/null
+++ b/ucsim/src/sims/s51.src/rd2_eepromcl.h
@@ -0,0 +1,155 @@
+/*
+ * AT89C51ED2 on-chip 2048-byte data EEPROM behind EECON (0xd2) -- doc4235K section 23
+ * (printed pp.89-92), table 23-1 (printed p.91), table 3-10 (printed p.7) and tWRITE of
+ * table 25-2 (printed p.115).
+ *
+ * WHAT THE DATASHEET ACTUALLY SAYS, and what follows from it:
+ *
+ *  - Bits.  EECON is "EEPROM Control Register" at 0D2h with exactly two defined bits
+ *    (table 23-1, printed pp.91-92): bit 1 EEE "Enable EEPROM Space bit -- Set to map the
+ *    EEPROM space during MOVX instructions (Write or Read to the EEPROM.  Clear to map the
+ *    XRAM space during MOVX", and bit 0 EEBUSY "Programming Busy flag -- Set by hardware
+ *    when programming is in progress... Can not be set or cleared by software".  Bits 7:2
+ *    are Reserved: "The value read from this bit is indeterminate.  Do not set this bit."
+ *    Reset value "XXXX XX00b", and the register is "Not bit addressable" (printed p.92),
+ *    so a guest cannot `JB EECON.0` -- bit address 0D2h is PSW.2, not EEBUSY -- and has to
+ *    poll with `MOV A,EECON` + `JB ACC,` as figures 23-1/23-2 (printed pp.90-91) do.
+ *  - Addressing.  There is NO address or data SFR.  "The 2K bytes on-chip EEPROM memory
+ *    block is located at addresses 0000h to 07FFh of the XRAM/ERAM memory space and is
+ *    selected by setting control bits in the EECON register.  A read or write access to the
+ *    EEPROM memory is done with a MOVX instruction" (printed p.89): DPTR carries the
+ *    address, ACC the byte, exactly as for external RAM.  So the array is not a new address
+ *    space, it is an overlay of the first 2048 bytes of the MOVX space while EEE is set --
+ *    which is what makes it a per-access decision rather than a decoder swap: the bytes
+ *    under it are still the XRAM/external-bus cells of cl_uc89c51r::decode_xram(), whose
+ *    own mapping depends on AUXR.EXTRAM and AUXR.XRS2:XRS0 (section 9, printed p.23).
+ *    Nothing is said about the two mappings colliding, and EEE is stated unconditionally
+ *    while the on-chip XRAM is the conditional one, so EEE wins over EXTRAM here; that
+ *    decision, and the 07FFh edge above which the bus stays external, are pinned by
+ *    t/eepromtest.py so they are visible rather than implied.
+ *  - Erase.  There is no erase trigger for this array.  Section 23.1 (printed p.89) is the
+ *    whole write procedure -- check EEBUSY, set EEE, `MOVX @DPTR,A`, clear EEE -- and names
+ *    no erase, no page and no second write; section 23.2 is its read mirror.  Contrast the
+ *    *Flash* chapter, which does state both a page (128 B) and a self-erase
+ *    ("It is not necessary to erase a byte or a page before programming", section 24.2,
+ *    printed p.93).  Erasing the data EEPROM exists only on the ISP side, as the "Program
+ *    EEPROM data" command of table 24-9 (printed p.110) and through full chip erase.
+ *  - Security.  Nothing in EECON locks the array: there is no lock bit to model.  The
+ *    Security the datasheet does have is the Software Security Bits of section 24.8.1
+ *    (printed p.103), which "protects any Flash access from ISP command" -- table 24-7 puts
+ *    "Flash/EEPROM" at read-only for level 1 and no access for level 2 -- and the Boot ROM
+ *    API, whose constraint list (section 24.10.2, printed p.111) asks the application to
+ *    disable interrupts around EEPROM-data access.  Both are bootloader-side; neither is a
+ *    bit the running program can set to bar its own MOVX access.
+ *  - Which part.  "This feature is available only for the AT89C51ED2 device" (printed p.89),
+ *    "On-chip 2048 Bytes EEPROM Block for Data Storage (AT89C51ED2 Only)" (features list,
+ *    printed p.1), "EEPROM data Memory SFR (AT89C51ED2 only)" (table 3-10, printed p.7).
+ *    Chapter 3 is a family chapter, so EECON is *named* on the RD2 as well (SIMULATION-PLAN.md
+ *    D14) -- but no element is created there, and the register stays as today: writable and
+ *    inert.  Registration lives in cl_uc89c51rd2::mk_hw_elements() behind an ED2-only
+ *    predicate, and the RD2 negative control is t/xramtest.py::eecon_does_not_remap plus the
+ *    absence legs of t/eepromtest.py.
+ *  - Endurance/retention.  The features list gives the block "100K Write Cycles" (printed
+ *    p.1); section 23 itself gives no endurance or retention figure, and the "10 years data
+ *    retention" of section 24.1 (printed p.93) belongs to the Flash.  Wear is therefore not
+ *    modelled -- nothing observable depends on it and no counter would be checked against a
+ *    datasheet number.
+ *
+ * tWRITE, and why it is modelled rather than declared zero.  Table 25-2 (printed p.115)
+ * lists `tWRITE  Flash or EEdata programming time  7 [min] 17 [max] ms, 2.7 < VCC < 5.5V`;
+ * the two-number rows of that table are Min and Max with Typ left blank (compare `VIL
+ * -0.5 / 0.2VCC-0.1` two rows above it), so 17 ms is the worst case and the model uses the
+ * worst case: a guest whose EEBUSY wait loop passes here cannot fail on this axis on
+ * silicon, which is the only direction a simulator may be wrong in.  The delay is measured
+ * in real time, not machine cycles -- the programming time is an on-chip charge pump and the
+ * datasheet gives it in milliseconds, so the target is uc->clocks_of_time(0.017) oscillator
+ * clocks and what accumulates is cycles * uc->clock_per_cycle(), which makes the window
+ * independent of CKCON0.X2 and of the CKRL prescaler, both of which change what a cycle is
+ * worth (section 6.2.1, printed p.16) while changing nothing about a millisecond.
+ * A guest observes it exactly the way the datasheet tells it to: EEBUSY
+ * reads 1 from the MOVX that starts the cycle until the hardware clears it, and section 23.1
+ * says the segment is "not available for reading or writing" meanwhile, so the byte does not
+ * appear in the array until the cycle completes (commit on completion, see write()), a read
+ * of any byte of the window while busy answers 0xff and counts as a blocked read, and a write
+ * is refused and counted rather than queued -- one byte in flight, because a single-port
+ * array cannot hold two.
+ *
+ * Persistence, and why there is no file.  A real EEPROM is non-volatile and a simulator
+ * holding 2048 bytes of RAM is not; this model closes part of that gap and states the rest.
+ * The array is a member of the element and is deliberately NOT cleared by reset(), because
+ * `reset` is the only power-cycle-like event the simulator has and content that vanishes
+ * under it would advertise the opposite of non-volatility -- a guest can write a byte, reset
+ * and read it back, which is the property an application actually relies on.  What the
+ * element does drop on reset is its volatile state: a program cycle in flight, its pending
+ * byte and its counters, matching cl_rd2_brg and cl_rd2_spi.  A backing file was rejected:
+ * ucsim has no notion of VCC being removed, so "when to load and when to flush" has no
+ * trigger inside the model, and a file that a stray `-t 89C51ED2` run silently rewrote would
+ * put stale contents in front of every test in the floor.  If it is ever wanted, the honest
+ * form is an explicit, default-off option that names the file (nothing loads or flushes
+ * unless the file is named), not a default-on side effect.
+ *
+ * Copyright (C) 2026 Oleksiy <alexian79@gmail.com>
+ * GPL-2.0-or-later
+ */
+
+#ifndef RD2_EEPROMCL_HEADER
+#define RD2_EEPROMCL_HEADER
+
+#include "hwcl.h"
+
+/* cl_hw ids in the HW_TIMER category are a bus other peripherals switch on, so a new one
+   is claimed against every header that names one plus the element that has no header of
+   its own, and NOT against upstream alone (that is how the SPI and the keyboard ended up
+   both answering id 14; see rd2_spiccl.h:40-49).  Checked on 2026-11-14 against:
+   rd2_brgcl.h:30 RD2_BRG_ID 13, rd2_kbdcl.h:47 RD2_KBD_ID 14, rd2_spiccl.h:50 RD2_SPI_ID 15,
+   rd2_bootcl.h:63 RD2_BOOT_ID 16, serial.cc:124-131 (dispatches on 2 and RD2_BRG_ID),
+   stc12_adc.cc:29 (10), stc12_brt.cc:28 (3), stc12_wdt.cc (11), stc15_timer2.cc (12), and
+   timer0.cc/timer2.cc, which take ids 0, 1 and 2 from their constructor argument.  Free at
+   and above 17; the EEPROM takes 17.  Nothing partners with it: it publishes no events. */
+#define RD2_EE_ID 17
+
+/* The array: 0000h..07FFh of the MOVX space (printed p.89). */
+#define RD2_EE_SIZE 2048
+#define RD2_EE_LAST 0x7ff
+
+/* tWRITE worst case, seconds (table 25-2, printed p.115). */
+#define RD2_EE_TWRITE_SEC 0.017
+
+class cl_memory_cell;
+class cl_address_space;
+
+class cl_rd2_eeprom: public cl_hw
+{
+protected:
+  class cl_memory_cell *cell_eecon;      /* EECON (0xd2): registered, hook keeps bit 0 true */
+  class cl_address_space *xram;          /* the MOVX space the array overlays */
+  unsigned char array[RD2_EE_SIZE];      /* the EEPROM itself; survives reset() */
+  bool busy;                             /* EEBUSY: a program cycle is in flight */
+  t_addr pend_addr;                      /* byte the in-flight cycle will commit */
+  unsigned char pend_val;
+  unsigned long elapsed;                 /* oscillator clocks inside this cycle */
+  double busy_clocks;                    /* clocks a cycle costs at the current xtal */
+  unsigned long n_bytes;                 /* programmed bytes, for `info hardware` */
+  unsigned long n_cycles;                /* completed program cycles */
+  unsigned long n_blk_rd;                /* reads refused while busy */
+  unsigned long n_blk_wr;                /* writes refused while busy */
+
+public:
+  cl_rd2_eeprom(class cl_uc *auc);
+  virtual int init(void);
+  virtual int tick(int cycles);
+  virtual t_mem read(class cl_memory_cell *cell);
+  virtual void write(class cl_memory_cell *cell, t_mem *val);
+  virtual void reset(void);
+  virtual void print_info(class cl_console_base *con);
+
+protected:
+  bool in_window(class cl_memory_cell *cell, t_addr *addr);  /* a cell of ours? */
+  bool mapped(void);                     /* EEE: is the array in front of the window? */
+  double cycle_clocks(void);             /* tWRITE in oscillator clocks, now */
+  void start_cycle(t_addr addr, t_mem val);
+  void end_cycle(void);
+};
+
+#endif
+/* End of s51.src/rd2_eepromcl.h */
diff --git a/ucsim/src/sims/s51.src/rd2_kbd.cc b/ucsim/src/sims/s51.src/rd2_kbd.cc
new file mode 100644
index 0000000..aa3bf72
--- /dev/null
+++ b/ucsim/src/sims/s51.src/rd2_kbd.cc
@@ -0,0 +1,259 @@
+/*
+ * Simulator of microcontrollers (rd2_kbd.cc)
+ *
+ * AT89C51RD2/ED2 keyboard interface and its interrupt source; see rd2_kbdcl.h for
+ * the feature summary and the datasheet citations.
+ *
+ * Copyright (C) 2026 Oleksiy <alexian79@gmail.com>
+ * GPL-2.0-or-later
+ */
+
+#include "rd2_kbdcl.h"
+#include "regs51.h"
+
+
+cl_rd2_kbd::cl_rd2_kbd(class cl_uc *auc):
+  cl_hw(auc, HW_TIMER, RD2_KBD_ID, "kbd")
+{
+  cell_kbds= 0;
+  cell_kbe= 0;
+  cell_kbf= 0;
+  cell_p1= 0;
+  cell_ien1= 0;
+  keys= 0;
+}
+
+int
+cl_rd2_kbd::init(void)
+{
+  /* cl_hw::init() first: it sets on, creates the cfg space and registers kbd14_on,
+     which is what `set hardware kbd off' and the tick loop consult. */
+  cl_hw::init();
+  class cl_address_space *sfr= uc->address_space(MEM_SFR_ID);
+  if (sfr)
+    {
+      /* KBLS and KBE are the registers the comparator reads, so they are plain
+         cells: the cell itself is the truth and there is nothing to cache, which
+         also means a `reset kbd` cannot leave a stale copy behind.  P1 is read
+         through the port's own read hook (`cell->read()', not `get()') because the
+         keyboard sits on the pins, not on the output latch: cl_port::read() returns
+         latch AND port_pins, which is what MOV A,P1 would answer.  IEN1 is only
+         ever read.  KBF is deliberately NOT registered here -- see added_to_uc(). */
+      cell_kbds= sfr->get_cell(KBLS);
+      cell_kbe= sfr->get_cell(KBE);
+      cell_kbf= sfr->get_cell(KBF);
+      cell_p1= sfr->get_cell(P1);
+      cell_ien1= sfr->get_cell(IEN1);
+
+      /* The read/write hooks of this element only work if it is the LAST operator
+	 on the KBF cell, and here it is: cl_hw_list::add() ran added_to_uc() before
+	 the caller got to init(), so cl_rd2_kbd_it::init() has already appended the
+	 interrupt source's own operator (its read() is a bare `cell->get()') and this
+	 append lands after it.  Measured, not assumed: appended from added_to_uc()
+	 instead -- where cell_kbf is still null, which is worse -- the cell keeps a
+	 single operator, the source's, and `MOV A,KBF' answers with the raw cell
+	 forever, so the read-clear of table 15-1 (p.60) never happens. */
+      register_cell(cell_kbf);
+    }
+  return 0;
+}
+
+/*
+ * The interrupt source is built here, not in init(): it needs uc->it_sources and
+ * the SFR cells to exist, which is the same contract cl_interrupt, cl_timer0,
+ * cl_serial and cl_pca follow.
+ *
+ * The rank comes from poll_priority, not from a hand-picked index.  it_sources is a
+ * cl_irqs, i.e. a cl_sorted_list keyed on poll_priority (itsrc.cc, and
+ * cl_sorted_list::add() -> search() -> add_at(i) in pobj.cc), so add() puts rank 8
+ * behind timer #2 (7) by itself.  pca.cc's add_at(4) is the same placement written
+ * out by hand for rank 5; hard-coding an index here would only go stale the day a
+ * source is registered before this one.
+ *
+ * added_to_uc() runs BEFORE init(), not after it: cl_uc::add_hw() ends in
+ * cl_hw_list::add(), which calls added_to_uc() as its last step (hw.cc), and only
+ * then does mk_hw_elements() call h->init().  So the cells are not resolved yet
+ * here and nothing of theirs may be touched; the KBF operator is appended in
+ * init() instead, which is also the position that makes this element the last
+ * operator on the cell (see init()).
+ */
+void
+cl_rd2_kbd::added_to_uc(void)
+{
+  class cl_address_space *sfr= uc->address_space(MEM_SFR_ID);
+  class cl_it_src *is;
+
+  if (!sfr || !uc->it_sources)
+    return;
+  is= new cl_rd2_kbd_it(uc, this, sfr->get_cell(IEN1), sfr->get_cell(KBF));
+  uc->it_sources->add(is);
+  is->init();
+  /* Deliberately no register_cell() here: cell_kbf is still null at this point and
+     the operator has to sit at the END of the KBF cell's operator list, which
+     init() -- running right after this -- is what achieves. */
+}
+
+/*
+ * One sample of the comparator of figure 15-2 (p.59).  Both senses are evaluated
+ * for all eight lines at once: a line whose KBLS bit is clear is a key when the
+ * pin is low, and a line whose KBLS bit is set is a key when the pin is high.
+ *
+ * Setting is cumulative and never cleared here -- table 15-1 says the flag is set
+ * by hardware when the line detects the programmed level and cleared only by a
+ * read of the register, so holding a key down keeps the flag set across the read
+ * that cleared it.  The cell is only touched when the value actually moved, so a
+ * quiescent port does not mark every SFR in the trace.
+ */
+void
+cl_rd2_kbd::sample(void)
+{
+  t_mem pins, kbls, hit, want;
+
+  if (!cell_p1 || !cell_kbds || !cell_kbf)
+    return;
+  pins= cell_p1->read() & 0xff;
+  kbls= cell_kbds->get() & 0xff;
+  hit= ((~pins) & (~kbls) & 0xff) | (pins & kbls);
+  want= (keys | hit) & 0xff;
+  keys= (unsigned char)want;
+  if (cell_kbf->get() != want)
+    cell_kbf->set(want);
+}
+
+bool
+cl_rd2_kbd::request(void)
+{
+  if (!cell_kbe)
+    return false;
+  return (keys & cell_kbe->get() & 0xff) != 0;
+}
+
+bool
+cl_rd2_kbd::global_enabled(void)
+{
+  return cell_ien1 && ((cell_ien1->get() & bmKBD) != 0);
+}
+
+/*
+ * The comparator is asynchronous -- CKCON0/CKCON1 (tables 7-1/7-2, pp.18-19) have
+ * clock-hold bits for the watchdog, PCA, UART and the three timers and none for the
+ * keyboard -- so it is evaluated once per machine cycle instead of being counted,
+ * and tick_hw() hands every element exactly one cycle per call (uc.cc).  Sampling
+ * here rather than from an EV_PORT_CHANGED partner (the route SIMULATION-PLAN.md
+ * phase 3 proposed) is what makes the other two inputs of the comparator work: the
+ * answer also changes when KBLS is written and when the part comes out of reset
+ * with P1 at 0xff and a KBLS bit set, and a port-change event reports neither.
+ * cl_uc::do_inst() runs tick_hw() before do_interrupt(), so a `MOV P1,#..' that
+ * presses a key has its request visible in the same instruction boundary.
+ */
+int
+cl_rd2_kbd::tick(int cycles)
+{
+  if (cycles > 0)
+    sample();
+  return resGO;
+}
+
+/*
+ * KBF is a read-only register: a write from firmware must leave the flags alone, so
+ * the incoming value is replaced by the model's own.  That also makes the reset path
+ * agree -- cl_51core::reset() runs every element's reset() before clear_sfr() pokes
+ * the registers, so by the time cl_uc89c51rd2::clear_sfr() writes KBF = 0 through
+ * this hook, `keys' is already 0 and the cell really does end up clear.
+ *
+ * KBLS and KBE need no handling: the comparator reads them out of the cells.
+ */
+void
+cl_rd2_kbd::write(class cl_memory_cell *cell, t_mem *val)
+{
+  if (cell == cell_kbf)
+    *val= keys;
+}
+
+/*
+ * Reading KBF clears it (table 15-1, p.60: "all flags are automatically cleared by
+ * reading the register"), which is also the only way software has of clearing it --
+ * the per-bit text's "must be cleared by software" and the register-level
+ * "automatically cleared by reading" are the same act (SIMULATION-PLAN.md 3.2
+ * records the contradiction and picks this reading).  Anything else -- the cfg cells
+ * of this element, and the KBLS/KBE cells registered above -- keeps the base
+ * behaviour, which is conf() plus the cell value.
+ */
+t_mem
+cl_rd2_kbd::read(class cl_memory_cell *cell)
+{
+  if (cell == cell_kbf)
+    {
+      t_mem v= keys;
+      keys= 0;
+      cell_kbf->set(0);
+      return v;
+    }
+  return cl_hw::read(cell);
+}
+
+/*
+ * Reset state of the three registers is 0000 0000b for each (tables 15-1/15-2/15-3,
+ * confirmed by the SFR map on p.8), so no line can be a key and no line can request.
+ * keys comes from that constant and not from reading the cell back, because
+ * cl_uc::reset() runs this before cl_51core::clear_sfr() has touched the registers;
+ * the set() keeps a standalone `reset kbd' self-sufficient as well.
+ */
+void
+cl_rd2_kbd::reset(void)
+{
+  keys= 0;
+  if (cell_kbf)
+    cell_kbf->set(0);
+}
+
+void
+cl_rd2_kbd::print_info(class cl_console_base *con)
+{
+  t_mem kbds= cell_kbds ? (cell_kbds->get() & 0xff) : 0;
+  t_mem kbe= cell_kbe ? (cell_kbe->get() & 0xff) : 0;
+  t_mem p1= cell_p1 ? (cell_p1->read() & 0xff) : 0;
+  t_mem sensed= keys;
+  t_mem masked= sensed & kbe;
+
+  con->dd_printf("kbd[%d] KBLS=0x%02x KBE=0x%02x KBF=0x%02x P1=0x%02x "
+		 "sensed=0x%02x request=%s KBD=%d EA=%d\n",
+		 id, (unsigned)kbds, (unsigned)kbe, (unsigned)sensed, (unsigned)p1,
+		 (unsigned)sensed, (masked ? "YES" : "no"),
+		 global_enabled() ? 1 : 0, uc->it_enabled() ? 1 : 0);
+  con->dd_printf("KBF&KBE=0x%02x vector=0x003b poll=8 level=%d "
+		 "(IPL1.0/IPH1.0)\n",
+		 (unsigned)masked, uc->priority_of(IP_PAIR1 | bmKBDL));
+}
+
+
+/*
+ * cl_it_src of the keyboard -- see the class comment in rd2_kbdcl.h for why the two
+ * predicates below cannot come from the base class.
+ */
+cl_rd2_kbd_it::cl_rd2_kbd_it(class cl_uc *Iuc, class cl_rd2_kbd *akbd,
+                             class cl_memory_cell *Iie_cell,
+                             class cl_memory_cell *Isrc_cell):
+  cl_it_src(Iuc, IP_PAIR1 | bmKBDL,
+            Iie_cell, IP_PAIR1 | bmKBDL,
+            Isrc_cell, 0xff,
+            0x003b, false, false,
+            "keyboard", 8)
+{
+  kbd= akbd;
+}
+
+bool
+cl_rd2_kbd_it::enabled(void)
+{
+  return kbd && kbd->global_enabled();
+}
+
+bool
+cl_rd2_kbd_it::pending(void)
+{
+  return kbd && kbd->request();
+}
+
+
+/* End of s51.src/rd2_kbd.cc */
diff --git a/ucsim/src/sims/s51.src/rd2_kbdcl.h b/ucsim/src/sims/s51.src/rd2_kbdcl.h
new file mode 100644
index 0000000..83d80ba
--- /dev/null
+++ b/ucsim/src/sims/s51.src/rd2_kbdcl.h
@@ -0,0 +1,111 @@
+/*
+ * AT89C51RD2/ED2 keyboard interface (doc4235K section 15, pp.59-62) — eight
+ * level-programmable inputs on P1.0..P1.7 that share one interrupt vector.
+ *
+ * Registers (doc4235K tables 15-1/15-2/15-3, pp.60-62):
+ *   KBLS 0x9c  level select: 0 = a low level on P1.x is a key, 1 = a high level.
+ *   KBE  0x9d  per-line request enable: "Set to enable KBF.x bit in KBF register
+ *              to generate an interrupt request", "Cleared to enable standard I/O
+ *              pin" — it gates the REQUEST, not the flag.
+ *   KBF  0x9e  flag: "Set by hardware when the Port line x detects a programmed
+ *              level", "read only access, all flags are automatically cleared by
+ *              reading the register" — read-clear, and a write changes nothing.
+ * Request (figure 15-2, p.59): KBDIT = OR over x of (KBF.x AND KBE.x); the global
+ * enable is IEN1.KBD (0xb1 bit 0, table 17-6 p.77), the levels come from
+ * IPL1.KBDL/IPH1.KBDH (0xb2/0xb3 bit 0, tables 17-7/17-8 pp.78-79) and the vector
+ * is 0x003b at polling rank 8 (table 17-2 p.73).
+ *
+ * What the document does NOT say, and the reading taken here: nothing states
+ * whether the flag is set only on the transition into the programmed level or
+ * continuously while it is present.  Section 15 (p.59) calls the interface
+ * "8 inputs with programmable interrupt capability on both high or low level" and
+ * p.82 lists the keyboard alongside INT0#/INT1# as a power-down exit "same
+ * behavior as external interrupt", which is level behaviour, so the flag is set
+ * for as long as the level is applied: reading KBF clears it and the next sample
+ * re-sets it if the key is still down.  KBF is set regardless of KBE, and there is
+ * no clock-control bit for this interface anywhere in CKCON0/CKCON1 (table 7-1
+ * pp.18-19 lists WDX2 PCAX2 SIX2 T2X2 T1X2 T0X2 X2 only), which is why the
+ * detector below is sampled every machine cycle rather than counted.
+ *
+ * Copyright (C) 2026 Oleksiy <alexian79@gmail.com>
+ * GPL-2.0-or-later
+ */
+
+#ifndef RD2_KBDCL_HEADER
+#define RD2_KBDCL_HEADER
+
+#include "hwcl.h"
+#include "itsrccl.h"
+
+/* cl_hw ids are a per-category bus other peripherals switch on (serial.cc
+   dispatches on HW_TIMER 1, 2, 3 and 12; 13 is the BRG, 15 the SPI).  The category
+   is reused rather than extended, exactly as cl_stc12_adc passes HW_TIMER for an
+   ADC, so the keyboard takes the next free HW_TIMER id: 14.  Nothing may partner
+   with it.  (Claim an id against *this* file and rd2_brgcl.h, not only against the
+   upstream list: the SPI sat on 14 from Phase 4 to 2026-11-13 for exactly that
+   reason, and no suite noticed, because `info hw` resolves by name.) */
+#define RD2_KBD_ID 14
+
+class cl_rd2_kbd: public cl_hw
+{
+protected:
+  class cl_memory_cell *cell_kbds;   /* KBLS (0x9c): level per line, cached by the cell */
+  class cl_memory_cell *cell_kbe;    /* KBE  (0x9d): request mask per line */
+  class cl_memory_cell *cell_kbf;    /* KBF  (0x9e): the flags; read-clear, write-ignored */
+  class cl_memory_cell *cell_p1;     /* P1   (0x90): the keys are its alternate function */
+  class cl_memory_cell *cell_ien1;   /* IEN1 (0xb1): bit 0 = KBD, the global enable */
+  unsigned char keys;                /* KBF, mirrored into the cell on every change */
+
+  void sample(void);                 /* the comparator: keys |= level match */
+
+public:
+  cl_rd2_kbd(class cl_uc *auc);
+  virtual int init(void);
+  virtual void added_to_uc(void);
+  virtual t_mem read(class cl_memory_cell *cell);
+  virtual void write(class cl_memory_cell *cell, t_mem *val);
+  virtual int tick(int cycles);
+  virtual void reset(void);
+  virtual void print_info(class cl_console_base *con);
+
+  /* the two questions the interrupt source asks, kept here because they are what
+     figure 15-2 draws: KBDIT is KBF AND KBE, and it reaches the core through
+     IEN1.KBD. */
+  bool request(void);
+  bool global_enabled(void);
+};
+
+
+/*
+ * The keyboard's interrupt source.  It is a subclass rather than a plain
+ * cl_it_src for the same reason SIMULATION-PLAN.md step 10 asked for one, and for
+ * a second practical reason: both halves of the base predicate are unexpressible
+ * as `masked cell == value'.
+ *
+ *   pending(): KBDIT is the OR of eight (KBF.x AND KBE.x) terms across two
+ *              registers, which no single mask of one cell can say.
+ *   enabled(): the ie_mask has to carry IP_PAIR1 so priority_of() knows to read
+ *              IPL1/IPH1 instead of IP/IPH (that flag is documented at
+ *              regs51.h), and the base enabled() ANDs that same mask with the
+ *              enable cell -- IEN1 -- whose bit 7 is a reserved bit.  A program
+ *              that wrote 0x81 to IEN1 would then find the keyboard disabled.
+ *              Answering from IEN1 bit 0 alone is what table 17-6 states.
+ *
+ * clr_bit stays false: the flag is not owned by the interrupt system, it is owned
+ * by the read of KBF (table 15-1, p.60).
+ */
+class cl_rd2_kbd_it: public cl_it_src
+{
+protected:
+  class cl_rd2_kbd *kbd;
+
+public:
+  cl_rd2_kbd_it(class cl_uc *Iuc, class cl_rd2_kbd *akbd,
+                class cl_memory_cell *Iie_cell, class cl_memory_cell *Isrc_cell);
+  virtual bool enabled(void);
+  virtual bool pending(void);
+};
+
+#endif
+
+/* End of s51.src/rd2_kbdcl.h */
diff --git a/ucsim/src/sims/s51.src/rd2_spi.cc b/ucsim/src/sims/s51.src/rd2_spi.cc
new file mode 100644
index 0000000..826fd22
--- /dev/null
+++ b/ucsim/src/sims/s51.src/rd2_spi.cc
@@ -0,0 +1,816 @@
+/*
+ * Simulator of microcontrollers (rd2_spi.cc)
+ *
+ * AT89C51RD2/ED2 Serial Peripheral Interface; see rd2_spiccl.h for the feature
+ * summary, the pin map and the list of what is deliberately not modelled.
+ * All section and page references are Atmel doc4235K (AT89C51RD2/ED2), pages as
+ * PRINTED: section 16 spans pp. 63-71, the pin map is table 4-1 on pp. 11-12, the
+ * clock-control registers are tables 7-1/7-2 on pp. 18-20 and the interrupt system
+ * is section 17 on pp. 72-79.
+ *
+ * Copyright (C) 2026 Oleksiy <alexian79@gmail.com>
+ * GPL-2.0-or-later
+ */
+
+#include "rd2_spiccl.h"
+#include "regs51.h"
+#include "portcl.h"
+#include "itsrccl.h"
+#include "uc89c51rcl.h"
+
+/*
+ * Bit 7 of an interrupt source's ie_mask selects the SECOND priority pair,
+ * IPL1/IPH1, in cl_51core::priority_of().  That macro is file-static in uc51.cc
+ * today, with a comment saying it belongs in regs51.h as soon as a source uses it;
+ * the cutover puts it there, so the guard below goes inert at that point rather
+ * than colliding with it.  It must stay 0x80: bit 7 is the only bit of ie_mask that
+ * no enable or priority bit of the first pair occupies.
+ */
+#ifndef IP_PAIR1
+#define IP_PAIR1 0x80
+#endif
+
+/* One byte costs the master eight full SCK cycles: "It is driven by the Master for
+   eight clock cycles which allows to exchange one Byte on the serial lines"
+   (section 16.2.3, printed p. 64), i.e. sixteen half-period edges. */
+#define SPI_EDGES 16
+
+
+/*
+ * Interrupt source of one SPI status flag.
+ *
+ * The AT89C51RD2 enables the SPI interrupt through IEN1 (0xb1) bit 2, ESPI, and takes
+ * it at vector 004Bh (section 17.1 and table 17-2, printed pp. 72-73); its two
+ * priority bits are SPIL/SPIH at bit 2 of IPL1/IPH1 (tables 17-6..17-8, printed
+ * pp. 77-79).  Those bit positions collide with the first pair's (PX1L/PT1L are bit 2
+ * of IPL0/IPH0 too), so priority_of() picks the pair from IP_PAIR1 in the ie_mask and
+ * the mask handed to cl_it_src is therefore NOT a plain enable mask.  The base
+ * enabled() tests `(IEN1 & ie_mask) == ie_value`, i.e. it ANDs the pair marker into
+ * the enable test, so `MOV IEN1,#0x84` -- IEN1 bit 7 is Reserved but readable --
+ * would read 0x84 against an ie_value of 0x04 and silently switch the SPI interrupt
+ * off.  The enable is therefore tested here against ESPI alone.
+ */
+class cl_rd2_spi_it_src: public cl_it_src
+{
+public:
+  cl_rd2_spi_it_src(class cl_uc *auc, class cl_memory_cell *ien1,
+                    t_mem flag_mask, class cl_memory_cell *spsta,
+                    const char *aname):
+    cl_it_src(auc, bmESPI, ien1, bmESPI | IP_PAIR1, spsta, flag_mask,
+              0x004b, false, false, aname, 10)
+  {}
+
+  virtual bool enabled(void)
+  {
+    return(ie_cell && (ie_cell->get() & bmESPI) != 0);
+  }
+};
+
+
+cl_rd2_spi::cl_rd2_spi(class cl_uc *auc):
+  cl_hw(auc, HW_TIMER /* reuse category, as cl_stc12_adc does */, RD2_SPI_ID, "spi")
+{
+  sfr_space= 0;
+  cell_spcn= 0;
+  cell_spst= 0;
+  cell_spdt= 0;
+  cell_ckcon1= 0;
+  cell_p1= 0;
+  reset();
+}
+
+int
+cl_rd2_spi::init(void)
+{
+  /* cl_hw::init() first: it sets on, creates spi14_cfg and registers spi14_on. */
+  cl_hw::init();
+  sfr_space= uc->address_space(MEM_SFR_ID);
+  if (sfr_space)
+    {
+      /* The three registers of the module are registered, not merely fetched: SPCON has
+	 to be seen because SPEN/MSTR/SSDIS transitions and the MODF clearing sequence are
+	 actions on it, SPSTA and SPDAT because their reads are the first and second
+	 accesses of the flag clearing sequences (section 16.3.3, printed pp. 67-68).
+	 CKCON1 is only read, and P1 is only driven with set(), so both are plain cells --
+	 registering P1 would put the SPI in the notification chain of a port that owns
+	 those pins already.  SPCON/SPSTA/SPDAT are named for the console by sfr_tab51 in
+	 uc51.cc, gated on CPU_89C51RD2, so nothing is added to vars here. */
+      cell_spcn= register_cell(sfr_space, SPCON);
+      cell_spst= register_cell(sfr_space, SPSTA);
+      cell_spdt= register_cell(sfr_space, SPDAT);
+      cell_ckcon1= sfr_space->get_cell(CKCON1);
+      cell_p1= sfr_space->get_cell(P1);
+    }
+  return 0;
+}
+
+void
+cl_rd2_spi::added_to_uc(void)
+{
+  class cl_address_space *sfr= uc->address_space(MEM_SFR_ID);
+  class cl_it_src *is;
+
+  if (!sfr)
+    return;
+  /* Table 16-2 (printed p. 68) and figure 16-7 (p. 69) give TWO requests out of this
+     module, both routed to the one vector 004Bh: SPIF raises the "SPI Transmitter"
+     request, MODF raises the "SPI Receiver/error" request.  The receiver/error request
+     is gated on SSDIS being cleared; that gate is structural rather than coded, because
+     MODF itself is only ever set with SSDIS cleared -- "When SSDIS... is cleared, the
+     MODF flag is set when the SS signal becomes '0'" (section 16.3.3.1, p. 68) and "When
+     SSDIS is set, no MODF interrupt request is generated" (table 16-3 bit 5, p. 69).  A
+     source that requests when nothing is enabled it is the defect class this part has
+     been bitten by before (SIMULATION-PLAN.md D1), so the enable really is IEN1.ESPI and
+     nothing else.
+     poll_priority 10 is the SPI row of table 17-2 ("Number 10, Polling Priority 10",
+     printed p. 73); it_sources is a cl_irqs sorted on that key and do_interrupt() keeps
+     the first source found at an equal level, so 10 -- higher than every other s51
+     source, which use 1..7 -- puts the SPI last in the polling sequence exactly as the
+     table does.  clr_bit is false for the same reason the UART's TI/RI sources use it:
+     the flags of section 16.3.3 clear only through their read sequences, never because
+     the interrupt was accepted, so the service routine has to run them. */
+  uc->it_sources->add(is= new cl_rd2_spi_it_src(uc, sfr->get_cell(IEN1), bmSPIF,
+						sfr->get_cell(SPSTA),
+						"spi transmitter"));
+  is->init();
+  uc->it_sources->add(is= new cl_rd2_spi_it_src(uc, sfr->get_cell(IEN1), bmMODF,
+						sfr->get_cell(SPSTA),
+						"spi receiver/error"));
+  is->init();
+}
+
+t_mem
+cl_rd2_spi::spcn(void)
+{
+  return cell_spcn ? (cell_spcn->get() & 0xff) : 0;
+}
+
+t_mem
+cl_rd2_spi::spsta(void)
+{
+  return cell_spst ? (cell_spst->get() & 0xff) : 0;
+}
+
+void
+cl_rd2_spi::set_flags(t_mem mask)
+{
+  if (cell_spst)
+    cell_spst->set(cell_spst->get() | mask);
+}
+
+void
+cl_rd2_spi::clear_flags(t_mem mask)
+{
+  if (cell_spst)
+    cell_spst->set(cell_spst->get() & ~mask);
+}
+
+/*
+ * P1 as the outside world sees it.  cl_port::read() answers a CPU read of the port
+ * with `latch & port_pins`, so that is also what the SPI must see on its SS, MISO,
+ * SCK and MOSI pins; reading the cell directly would ignore a bench that drives the
+ * pins through `port1_pin`/`set pin1`.
+ */
+t_mem
+cl_rd2_spi::pins(void)
+{
+  class cl_port *p;
+
+  if (!cell_p1)
+    return 0xff;
+  p= (class cl_port *)uc->get_hw(HW_PORT, 1, 0);
+  if (p)
+    return cell_p1->get() & p->port_pins;
+  return cell_p1->get() & 0xff;
+}
+
+/*
+ * Drive one of the SPI's own pins, leaving every other bit of the P1 latch alone.
+ * P1 is one latch shared with four other functions (P1.0 T2/CLKOUT, P1.1 T2EX/SS,
+ * P1.2 ECI, P1.3/P1.4 CEX0/CEX1, table 4-1), so a pin write is always a
+ * read-modify-write of it, and it goes in with set() so it does not re-enter the
+ * port's callbacks -- the idiom cl_pca's PWM outputs (pca.cc) and cl_timer2's T2
+ * clock out on P1.0 already use.  A consequence worth knowing: set() does not raise
+ * EV_PORT_CHANGED either, so SPI traffic on P1.6/P1.7 cannot trigger a PCA capture
+ * on CEX3/CEX4.  The masks passed here are always subsets of SCK|MOSI|MISO; SS
+ * (P1.1, shared with T2EX) is an input in both modes and is never driven.
+ */
+void
+cl_rd2_spi::drive(t_mem mask, bool high)
+{
+  t_mem v, n;
+
+  if (!cell_p1 || !mask)
+    return;
+  v= cell_p1->get() & 0xff;
+  n= (t_mem)((v & ~mask) | (high ? mask : 0));
+  if (n != v)
+    cell_p1->set(n);
+}
+
+void
+cl_rd2_spi::sck_level(bool high)
+{
+  if (level_sck == high)
+    return;
+  level_sck= high;
+  drive(SPI_PIN_SCK, high);
+}
+
+void
+cl_rd2_spi::out_level(bool high)
+{
+  if (level_out == high)
+    return;
+  level_out= high;
+  drive((spcn() & bmMSTR) ? SPI_PIN_MOSI : SPI_PIN_MISO, high);
+}
+
+/*
+ * The master clock divider of table 16-1 (printed p. 64): SPR2:SPR1:SPR0 select
+ * FCLK PERIPH divided by 2, 4, 8, 16, 32, 64 or 128.  The encodings are NOT
+ * contiguous -- SPR2 is bit 7 of SPCON while SPR1:SPR0 are bits 1:0 (table 16-3,
+ * printed pp. 69-70).  SPR=111 is printed "Don't Use / No BRG" in table 16-1 and
+ * "Invalid" in table 16-3 (printed p. 70): no defined behaviour, and a missing
+ * clock generator is the literal reading of "No BRG", so 0 (no clock, and therefore
+ * a transfer that never completes) is what is modelled.  A future port that finds a
+ * real device treating 111 as /256 has only to change this one line.
+ */
+int
+cl_rd2_spi::divider(void)
+{
+  t_mem s= spcn();
+  int spr;
+
+  spr= ((s & bmSPR2) ? 4 : 0) | ((s & bmSPR1) ? 2 : 0) | ((s & bmSPR0) ? 1 : 0);
+  if (spr >= 7)
+    return 0;
+  return 2 << spr;
+}
+
+/*
+ * Length of a half SCK period, in FCLK_PERIPH periods -- the SAME unit as the
+ * accumulator in tick(), which is the one unit mismatch this tree has already been
+ * bitten by (SIMULATION-PLAN.md D11), so it is spelled out here.
+ *
+ * cl_uc89c51r::fclk_periph_per_cycle() is 6 in both clock states: FCLK_PERIPH is
+ * Fosc/2 with CKCON0.X2 clear (section 6, and figure 7-1 on printed p. 18 shows the
+ * XTAL1/2 divider ahead of it) and Fosc with X2 set, while the machine cycle is Fosc/12
+ * and Fosc/6 (section 7.1.1, printed p. 17).  So one FCLK_PERIPH period is 2 oscillator
+ * clocks in standard mode and 1 in X2 mode, and a master bit -- BD of them -- costs
+ * 2*BD oscillator clocks standard, BD in X2 mode, i.e. BD/6 machine cycles either way.
+ *
+ * Section 16's table is what is implemented, because the plan says section 16 governs
+ * the SPI and section 7's story for SPIX2 is not reconcilable with it: table 7-2
+ * (printed p. 20) has SPIX2 select "6 clock periods per peripheral clock cycle" cleared
+ * and 12 set, which measures the SPI's own cycle against the oscillator and cannot be
+ * the same clock as FCLK_PERIPH (whose period is 2 oscillator clocks, not 12).  What
+ * survives of section 7 is the factor of two and its condition: SPIX2 is "validated
+ * when the CPU clock X2 is set; when X2 is low, this bit has no effect", and its job --
+ * like every other *X2 bit in the part -- is to hold one peripheral at standard speed
+ * while the CPU doubles.  So SPIX2 set with X2 set doubles the half period; every other
+ * combination leaves it alone.
+ */
+int
+cl_rd2_spi::half_period(void)
+{
+  int bd= divider();
+  int half;
+  t_mem ckcon0, ckcon1;
+
+  if (bd <= 0)
+    return 0;
+  half= bd >> 1;
+  if (sfr_space && cell_ckcon1)
+    {
+      ckcon0= sfr_space->read(CKCON0) & 0xff;
+      ckcon1= cell_ckcon1->get() & 0xff;
+      if ((ckcon0 & bmX2) && (ckcon1 & bmSPIX2))
+	half <<= 1;
+    }
+  return half;
+}
+
+/*
+ * Which of the two kinds of SCK edge this is.  Table 16-3 bit 2 (printed p. 70):
+ * CPHA "Cleared to have the data sampled when the SCK leaves the idle state (see
+ * CPOL). Set to have the data sampled when the SCK returns to idle state (see CPOL)".
+ * Edge 0 of a byte is by construction the edge that leaves the idle level, so the
+ * even positions leave idle and the odd positions return to it -- and because the
+ * idle level itself is CPOL, this one rule gives all four modes their documented
+ * edges without CPOL appearing at all: mode 0 samples on rising, mode 1 on falling,
+ * mode 2 on falling, mode 3 on rising.
+ */
+bool
+cl_rd2_spi::sample_edge(int pos)
+{
+  bool leaves_idle= ((pos & 1) == 0);
+
+  return ((spcn() & bmCPHA) != 0) ? !leaves_idle : leaves_idle;
+}
+
+void
+cl_rd2_spi::capture(bool in_high)
+{
+  /* "A Byte (8-bit word) is transmitted most significant bit (MSB) first, least
+     significant bit (LSB) last" (section 16.2.1/16.2.2, printed p. 63). */
+  rx_in= (unsigned char)((rx_in << 1) | (in_high ? 1 : 0));
+  captures++;
+  if (captures >= 8)
+    complete_byte();
+}
+
+/*
+ * One shift edge: the bit presented now is the one the peer samples on the following
+ * edge, and only then does the register make room for the next one.  With CPHA clear
+ * the MSB has already been presented by load_shift() at the moment SPDAT was written
+ * ("the first SCK edge is the MSB capture strobe.  Therefore, the Slave must begin
+ * driving its data before the first SCK edge", printed p. 67), so the seven shift
+ * edges of the byte carry bits 6..0; with CPHA set the first shift edge carries the
+ * MSB ("the Master begins driving its MOSI pin on the first SCK edge", p. 67) and the
+ * eight shift edges carry bits 7..0.  Either way the line is left holding the LSB
+ * when the byte ends.
+ */
+void
+cl_rd2_spi::shift_out(void)
+{
+  out_level((shift & 0x80) != 0);
+  shift= (unsigned char)(shift << 1);
+}
+
+void
+cl_rd2_spi::complete_byte(void)
+{
+  /* section 16.3.1.1 (printed p. 66): "The transmission ends when the Serial
+     Peripheral transfer data flag, SPIF, in SPSTA becomes set.  At the same time that
+     SPIF becomes set, the received Byte from the Slave is transferred to the receive
+     data register in SPDAT".  The receive register is the cell itself, so every other
+     reader of SPDAT sees the same byte. */
+  captures= 0;
+  rx_buf= rx_in;
+  if (cell_spdt)
+    cell_spdt->set(rx_buf);
+  set_flags(bmSPIF);
+  xferred++;
+}
+
+void
+cl_rd2_spi::load_shift(t_mem value)
+{
+  /* "A write to SPDAT places data directly into the shift register.  No transmit
+     buffer is available in this model" (section 16.3.5.3, printed p. 71). */
+  shift= (unsigned char)(value & 0xff);
+  if (!(spcn() & bmCPHA))
+    {
+      out_level((shift & 0x80) != 0);
+      shift= (unsigned char)(shift << 1);
+    }
+}
+
+void
+cl_rd2_spi::end_transfer(void)
+{
+  running= false;
+  acc= 0;
+  edge= 0;
+  captures= 0;
+  rx_in= 0;
+}
+
+/*
+ * section 16.3.3.1 (printed p. 68): a mode fault in master mode "An SPI receiver/error
+ * CPU interrupt request is generated", "The SPEN bit in SPCON is cleared.  This disables
+ * the SPI", "The MSTR bit in SPCON is cleared".  The request itself is raised by the
+ * MODF-cl_it_src created in added_to_uc(), which watches this very flag bit; nothing is
+ * called into the interrupt system here.
+ */
+void
+cl_rd2_spi::do_modf(void)
+{
+  t_mem s;
+
+  set_flags(bmMODF);
+  n_modf++;
+  s= cell_spcn->get() & ~(t_mem)(bmSPEN | bmMSTR);
+  cell_spcn->set(s);   /* set(): this is the model's own action, not a write to SPCON */
+  end_transfer();
+}
+
+/*
+ * The master's sixteenth edge has been reached: eight full SCK cycles.  SCK is left at
+ * the idle level CPOL defines ("CPOL defines the default SCK line level in idle state",
+ * printed p. 66), which is also why the generator runs the last cycle to its end even
+ * though SPIF was already raised half a cycle earlier in mode 0 and mode 3: the
+ * alternative reading -- stop the clock the moment the eighth bit is sampled -- leaves
+ * the line parked away from its idle level.
+ */
+void
+cl_rd2_spi::master_edge(void)
+{
+  int pos= edge % SPI_EDGES;
+  bool cpol= (spcn() & bmCPOL) != 0;
+
+  edge++;
+  if (captures < 8)
+    {
+      if (sample_edge(pos))
+	capture((pins() & SPI_PIN_MISO) != 0);
+      else
+	shift_out();
+    }
+  sck_level((pos & 1) == 0 ? !cpol : cpol);
+  if (edge >= SPI_EDGES)
+    {
+      edge= 0;
+      acc= 0;
+      running= false;
+      sck_level(cpol);
+    }
+}
+
+/*
+ * In slave mode SS decides whether this chip is selected.  Table 16-3 bit 5 (printed
+ * p. 69) is the whole rule: "Cleared to enable SS in both Master and Slave modes.  Set
+ * to disable SS in both Master and Slave modes.  In Slave mode, this bit has no effect
+ * if CPHA='0'".  So SSDIS frees the SS pin from selection only when CPHA is set, and
+ * with CPHA clear the pin keeps its select role -- which is the same thing footnote 2
+ * on printed p. 64 warns about ("Special care should be taken not to set SSDIS control
+ * bit when CPHA = '0' because in this mode, the SS is used to start the transmission").
+ */
+bool
+cl_rd2_spi::is_slave_selected(t_mem s, bool ss_low)
+{
+  bool ss_selects= !((s & bmSSDIS) && (s & bmCPHA));
+
+  return ss_low || !ss_selects;
+}
+
+int
+cl_rd2_spi::tick(int cycles)
+{
+  t_mem ctl, p;
+  bool ss_low, prev_ss, mstr, sck;
+  int half;
+
+  if (!cell_spcn || !cell_p1)
+    return resGO;
+  ctl= spcn();
+  if (!(ctl & bmSPEN))
+    {
+      /* "Serial Peripheral Enable: Cleared to disable the SPI interface" (table 16-3
+	 bit 6, printed p. 69) and "Clearing SPEN would immediately disable the
+	 peripheral" (printed p. 71).  Since SPCON resets to 0001 0100b -- MSTR set,
+	 SPEN clear -- a fresh part sits here and never touches a pin. */
+      return resGO;
+    }
+  p= pins();
+  ss_low= (p & SPI_PIN_SS) == 0;
+  prev_ss= pin_ss;
+  pin_ss= ss_low;
+  mstr= (ctl & bmMSTR) != 0;
+
+  if (mstr)
+    {
+      /* Master mode (section 16.3.1.1, printed p. 66): "Software begins the
+	 transmission from a Master SPI Module by writing to the Serial Peripheral Data
+	 Register (SPDAT)".  SS is an input here, and with SS handling enabled a low SS
+	 is a mode fault.  Level rather than edge, because table 16-4 bit 4 (printed
+	 p. 71) says MODF is "Set by hardware to indicate that the SS pin is at
+	 inappropriate logic level", and footnote 1 on printed p. 64 -- "Clearing SSDIS
+	 control bit does not clear MODF" -- is only useful if a SS that is already low
+	 is also caught the moment SSDIS is cleared. */
+      if (!(ctl & bmSSDIS) && ss_low && !(spsta() & bmMODF))
+	{
+	  do_modf();
+	  return resGO;
+	}
+      /* Re-assert the output pins from the model's own levels every cycle.  They are
+	 the SPI's pins while the module is enabled in master mode, and the latch is a
+	 shared byte the program may well write (a test driving MISO drives bits of the
+	 same latch); without this the pin would stay wrong until the next edge.
+
+	 MOSI is only asserted once the master has something to say: with CPHA clear
+	 load_shift() presents the MSB the moment SPDAT is written ("the first SCK edge
+	 is the MSB capture strobe.  Therefore, the Slave must begin driving its data
+	 before the first SCK edge", printed p. 67), while with CPHA set "the Master
+	 begins driving its MOSI pin on the first SCK edge" (same page, figure 16-5) --
+	 so before that first edge the latch keeps whatever the program left there. */
+      drive(SPI_PIN_SCK, level_sck);
+      if (edge || !(ctl & bmCPHA))
+	drive(SPI_PIN_MOSI, level_out);
+      if (!running)
+	return resGO;
+      half= half_period();
+      if (half <= 0)
+	{
+	  /* SPR=111: "Don't Use / No BRG" (table 16-1, printed p. 64).  No clock, so the
+	     byte sits in the shift register forever and SPIF is never raised. */
+	  return resGO;
+	}
+      /* FCLK_PERIPH periods banked since the last edge; see half_period() for the unit
+	 and for why six per machine cycle is right in both clock states. */
+      acc+= cycles * ((cl_uc89c51r *)uc)->fclk_periph_per_cycle();
+      while (acc >= half && running)
+	{
+	  acc-= half;
+	  master_edge();
+	}
+      return resGO;
+    }
+
+  /*
+   * Slave mode (section 16.3.1.2, printed p. 66): "The SPI operates in Slave mode when
+   * the Master bit, MSTR, in the SPCON register is cleared.  Before a data transmission
+   * occurs, the Slave Select pin, SS, of the Slave device must be set to '0'".  The
+   * clock and MOSI are inputs on P1.6 and P1.7 (table 4-1), sampled once per machine
+   * cycle, and the edges are classified by exactly the same CPHA rule the master uses --
+   * the datasheet is explicit that "The clock phase and polarity should be identical for
+   * the Master SPI device and the communicating Slave device" (printed p. 66), so the
+   * two must agree on which edge is which.
+   */
+  if (!prev_ss && ss_low && !((ctl & bmSSDIS) && (ctl & bmCPHA)))
+    {
+      /* SS falling (pin_ss records the level, so a clear prev_ss means SS had been
+	 high).  With CPHA clear this is the start-of-message strobe of figure 16-6
+	 The SS pin must be toggled high and then low between each Byte transmitted", so
+	 it also re-aligns the byte boundary.  With CPHA set the same figure shows SS
+	 free to stay low between bytes, so the boundary is left where the clock put it. */
+      if (!(ctl & bmCPHA))
+	{
+	  edge= 0;
+	  captures= 0;
+	  rx_in= 0;
+	}
+    }
+  else if (prev_ss && !ss_low && !((ctl & bmSSDIS) && (ctl & bmCPHA)))
+    {
+      /* SS released.  section 16.3.3.4 (printed p. 68): "A Synchronous Serial Slave
+	 Error occurs when SS goes high before the end of a received data in slave
+	 mode.  SSERR does not cause in interruption, this bit is cleared by writing 0
+	 to SPEN bit (reset of the SPI state machine)" -- so no interrupt source is
+	 attached to SSERR, it aborts the partial byte, and clear_flags() for it appears
+	 only in the SPEN transition. */
+      if (captures > 0)
+	{
+	  set_flags(bmSSERR);
+	  n_sserr++;
+	}
+      end_transfer();
+    }
+  if (!is_slave_selected(ctl, ss_low))
+    {
+      /* "A high level on the SS pin puts the MISO line of a Slave SPI in a
+	 high-impedance state" (section 16.2.4, printed p. 64).  A latch cell has no
+	 high impedance to model, so the pin is simply left alone from here on. */
+      return resGO;
+    }
+  drive(SPI_PIN_MISO, level_out);
+  sck= (p & SPI_PIN_SCK) != 0;
+  if (sck == pin_sck)
+    return resGO;
+  pin_sck= sck;
+  {
+    int pos= edge % SPI_EDGES;
+
+    edge++;
+    if (captures < 8)
+      {
+	if (sample_edge(pos))
+	  capture((pins() & SPI_PIN_MOSI) != 0);
+	else
+	  shift_out();
+      }
+  }
+  return resGO;
+}
+
+/*
+ * The datasheet's maximum SCK frequency for a slave is NOT enforced.  It cannot be:
+ * the clock arrives asynchronously on a port pin that is sampled once per machine
+ * cycle, and the datasheet contradicts itself about the limit anyway -- section
+ * 16.3.1.2 (printed p. 66) says "The maximum SCK frequency allowed in slave mode is
+ * FCLK PERIPH /4" while footnote 3 on the very same page says "The maximum frequency
+ * of the SCK for an SPI configured as a Slave is the bus clock speed".
+ */
+
+void
+cl_rd2_spi::write(class cl_memory_cell *cell, t_mem *val)
+{
+  t_mem old;
+
+  if (cell == cell_spcn)
+    {
+      old= cell_spcn->get() & 0xff;
+      /* "Clearing the MODF bit is accomplished by a read of SPSTA register with MODF bit
+	 set, followed by a write to the SPCON register" (section 16.3.3.1, printed
+	 p. 68).  Note that SPEN is *not* restored here: the same passage only says it
+	 "may be restored to its original set state", which is software's job. */
+      if (seq_m)
+	{
+	  seq_m= false;
+	  clear_flags(bmMODF);
+	}
+      if ((old & bmSPEN) && !(*val & bmSPEN))
+	{
+	  /* Clearing SPEN resets the state machine, and it is the only way out of SSERR
+	     (section 16.3.3.4, printed p. 68). */
+	  end_transfer();
+	  clear_flags(bmSSERR);
+	}
+      if (!(old & bmSPEN) && (*val & bmSPEN))
+	{
+	  /* Setting SPEN: start from a clean byte boundary, and take the input pins as
+	     they already are so a level that was there before the enable is not invented
+	     into an edge.  Footnotes 1 and 2 on printed p. 66 require the master/slave
+	     configuration (and CPOL/CPHA, footnote 4) to be programmed before SPEN. */
+	  end_transfer();
+	  pin_sck= (pins() & SPI_PIN_SCK) != 0;
+	  pin_ss= (pins() & SPI_PIN_SS) == 0;
+	  if (*val & bmMSTR)
+	    {
+	      /* The line takes on its idle level the moment the module is enabled,
+		 before any byte has been written.  Driven unconditionally rather than
+		 through sck_level(): the cached level starts out low, so a latch that
+		 the program had left high would otherwise keep SCK high while the
+		 master believes it is idling at CPOL=0. */
+	      level_sck= (*val & bmCPOL) != 0;
+	      drive(SPI_PIN_SCK, level_sck);
+	    }
+	}
+      return;
+    }
+
+  if (cell == cell_spst)
+    {
+      /* SPSTA is a flag register: all four bits are set and cleared by hardware, and the
+	 clearing mechanisms of section 16.3.3 (printed p. 68) are read/write *sequences*
+	 on other registers, never a write to SPSTA itself.  The value the program asked
+	 for is therefore dropped and the cell keeps the model's flags. */
+      *val= cell_spst->get();
+      return;
+    }
+
+  if (cell == cell_spdt)
+    {
+      t_mem v= *val & 0xff;
+
+      if (seq_f)
+	{
+	  /* Second access of the sequence that clears SPIF ("reading the Serial
+	     Peripheral Status register (SPSTA) with the SPIF bit set, and then reading
+	     the SPDAT", section 16.3.1.1 printed p. 66) and WCOL ("a software sequence of
+	     an access to SPSTA and an access to SPDAT", section 16.3.3.2 printed p. 68).
+	     An access, so this write closes the sequence exactly as a read would. */
+	  seq_f= false;
+	  clear_flags(bmSPIF | bmWCOL);
+	}
+      if (running && (spcn() & bmMSTR))
+	{
+	  /* section 16.3.3.2 (printed p. 68): "A Write Collision (WCOL) flag in the SPSTA
+	     is set when a write to the SPDAT register is done during a transmit sequence.
+	     WCOL does not cause an interruption, and the transfer continues
+	     uninterrupted."  Uninterrupted means the byte on the wire survives, so the
+	     shift register is not replaced -- that is also what makes the flag worth
+	     having.  Printed p. 71 names the same event an overflow ("Writing to the
+	     SPDAT will cause an overflow"). */
+	  set_flags(bmWCOL);
+	  n_wcol++;
+	}
+      else
+	{
+	  /* Master: "If the shift register is empty, the Byte is immediately transferred
+	     to the shift register" (section 16.3.1.1, printed p. 66) and the clock starts
+	     with it.  Slave: no clock of its own, so the write only arms the byte to be
+	     sent -- section 16.3.1.2 (printed p. 66) requires that write to be complete
+	     "at least one bus cycle before the Master SPI starts a transmission", and if
+	     it is late "the SPI transmits the data already in the shift register", which
+	     falls out of this model without any extra state. */
+	  load_shift(v);
+	  if ((spcn() & bmMSTR) && (spcn() & bmSPEN) && divider() > 0)
+	    {
+	      running= true;
+	      acc= 0;
+	      edge= 0;
+	      captures= 0;
+	    }
+	}
+      /* What lands in the cell is the receive buffer, because that is what a read of
+	 SPDAT answers: "A Read of the SPDAT returns the value located in the receive
+	 buffer and not the content of the shift register" (printed p. 71).  Other readers
+	 of this cell (the console, another registered operator) go through the cell, so
+	 they must not be left holding the written value. */
+      *val= rx_buf;
+      return;
+    }
+
+  cl_hw::write(cell, val);
+}
+
+t_mem
+cl_rd2_spi::read(class cl_memory_cell *cell)
+{
+  t_mem v;
+
+  if (cell == cell_spst)
+    {
+      v= cell_spst->get() & 0xff;
+      /* Every read of SPSTA is the FIRST access of a clearing sequence (see write()
+	 above), so arming happens here.  That makes a console `dump sfr` of SPSTA an
+	 action with a side effect -- a probe order that reads SPSTA and then SPDAT will
+	 clear SPIF.  `info hardware spi` reads the same flags through get(), which
+	 consults no hooks and is the probe a test should use. */
+      if (v & (bmSPIF | bmWCOL))
+	seq_f= true;
+      if (v & bmMODF)
+	seq_m= true;
+      return v;
+    }
+  if (cell == cell_spdt)
+    {
+      if (seq_f)
+	{
+	  seq_f= false;
+	  clear_flags(bmSPIF | bmWCOL);
+	}
+      return rx_buf;
+    }
+  return cl_hw::read(cell);
+}
+
+/*
+ * hw elements are reset before the SFRs are cleared (cl_51core::reset calls cl_uc::reset,
+ * which walks hws, and only then clear_sfr), so nothing here may be read back out of
+ * SPCON/SPSTA/SPDAT: the two levels that matter for a cold part come from the registers'
+ * reset constants instead -- SPCON = 0001 0100b, i.e. MSTR set, SPEN clear, SS left
+ * enabled, CPOL clear so SCK idles low and CPHA set (table 16-3, printed p. 70), and P1 =
+ * 0xff (cl_51core::clear_sfr) leaves SS high, which is the "only one Master" level of
+ * section 16.2.4.  No pin is driven from here: with SPEN reset clear the module is
+ * disabled, and driving would scribble over Port 1's reset image.
+ */
+void
+cl_rd2_spi::reset(void)
+{
+  shift= 0;
+  rx_in= 0;
+  rx_buf= 0;
+  level_sck= false;
+  level_out= false;
+  running= false;
+  acc= 0;
+  edge= 0;
+  captures= 0;
+  seq_f= false;
+  seq_m= false;
+  pin_sck= false;
+  pin_ss= true;
+  xferred= 0;
+  n_wcol= 0;
+  n_modf= 0;
+  n_sserr= 0;
+}
+
+void
+cl_rd2_spi::print_info(class cl_console_base *con)
+{
+  t_mem s= spcn();
+  t_mem f= spsta();
+  t_mem p= pins();
+
+  /* BD=0 is SPR=111, "Don't Use / No BRG" (table 16-1, printed p. 64): no divider, so
+     half=0 and no edge is ever produced.  Every value here is read with get(), never
+     through a read hook, so printing the state cannot consume a clearing sequence --
+     which is why the flags are also spelled out by name below: a `dump sfr 0xc3 0xc5`
+     would. */
+  con->dd_printf("spi[%d] %s%s SPCON=0x%02x SPR=%d BD=%d half=%d SPIX2=%d "
+		 "SPEN=%d SSDIS=%d MSTR=%d CPOL=%d CPHA=%d\n",
+		 id, (s & bmSPEN) ? "SPEN" : "disabled",
+		 (s & bmMSTR) ? " master" : " slave", (unsigned)s,
+		 ((s & bmSPR2) ? 4 : 0) | ((s & bmSPR1) ? 2 : 0) | (s & bmSPR0),
+		 divider(), half_period(),
+		 (cell_ckcon1 && (cell_ckcon1->get() & bmSPIX2)) ? 1 : 0,
+		 (s & bmSPEN) ? 1 : 0, (s & bmSSDIS) ? 1 : 0,
+		 (s & bmMSTR) ? 1 : 0, (s & bmCPOL) ? 1 : 0, (s & bmCPHA) ? 1 : 0);
+  con->dd_printf("SPSTA=0x%02x SPIF=%d WCOL=%d SSERR=%d MODF=%d SPDAT=0x%02x\n",
+		 (unsigned)f, (f & bmSPIF) ? 1 : 0, (f & bmWCOL) ? 1 : 0,
+		 (f & bmSSERR) ? 1 : 0, (f & bmMODF) ? 1 : 0, (unsigned)rx_buf);
+  con->dd_printf("shift=0x%02x rx_in=0x%02x running=%d edge=%d captures=%d acc=%d "
+		 "seq=%d%d\n",
+		 (unsigned)shift, (unsigned)rx_in, running ? 1 : 0, edge, captures, acc,
+		 seq_f ? 1 : 0, seq_m ? 1 : 0);
+  /* The four pins in their electrical polarity (SS=1 means the SS pin is high, i.e. a
+     slave would be deselected), with the whole latch alongside so a test can see that the
+     other five bits of Port 1 are untouched. */
+  /* The trailing four numbers are EVENT COUNTERS, not the SPSTA flags printed on the
+     line above: a MODF that was raised and then cleared by its sequence still counts
+     here, and that is exactly what a test wants to distinguish.  They are named
+     *_events for that reason -- spelling them WCOL/MODF/SSERR again made the last line
+     silently shadow the flag line for any reader that parses key=value. */
+  con->dd_printf("P1=0x%02x SS=%d MISO=%d SCK=%d MOSI=%d; "
+		 "bytes=%lu wcol_events=%lu modf_events=%lu sserr_events=%lu\n",
+		 (unsigned)p, (p & SPI_PIN_SS) ? 1 : 0, (p & SPI_PIN_MISO) ? 1 : 0,
+		 (p & SPI_PIN_SCK) ? 1 : 0, (p & SPI_PIN_MOSI) ? 1 : 0,
+		 xferred, n_wcol, n_modf, n_sserr);
+}
+
+
+/* End of s51.src/rd2_spi.cc */
diff --git a/ucsim/src/sims/s51.src/rd2_spiccl.h b/ucsim/src/sims/s51.src/rd2_spiccl.h
new file mode 100644
index 0000000..3d8b57d
--- /dev/null
+++ b/ucsim/src/sims/s51.src/rd2_spiccl.h
@@ -0,0 +1,123 @@
+/*
+ * AT89C51RD2/ED2 Serial Peripheral Interface (SPI) -- doc4235K section 16 (printed
+ * pp. 63-71), the three registers SPCON (0xc3), SPSTA (0xc4) and SPDAT (0xc5), the
+ * master clock divider of table 16-1 scaled by CKCON1.SPIX2, and the two interrupt
+ * requests of table 16-2.
+ *
+ * Pins (doc4235 table 4-1, printed pp. 11-12, and the pin list on printed p. 9):
+ * the four signals are the alternate functions of four Port 1 pins --
+ *
+ *   P1.1  T2EX / SS     0x02   input  to the model in both modes
+ *   P1.5  CEX2 / MISO   0x20   output in slave mode, input in master mode
+ *   P1.6  CEX3 / SCK    0x40   output in master mode, input in slave mode
+ *   P1.7  CEX4 / MOSI   0x80   output in master mode, input in slave mode
+ *
+ * so the block drives and samples the existing P1 latch rather than inventing a
+ * port of its own: outputs are read-modify-writes of the P1 SFR cell through
+ * set() (the idiom cl_pca's PWM output and cl_timer2's T2 clock-out already use),
+ * and inputs are read as `latch & port_pins`, which is exactly what cl_port::read()
+ * hands the CPU.  Nothing else in the latch is ever touched: P1.0/P1.2/P1.3/P1.4
+ * keep whatever the program put there, and P1.1 is NEVER written -- SS is an input
+ * in master mode (§16.2.4 has the master selecting its slaves with ordinary port
+ * pins of its own) and an input in slave mode as well, which is also what keeps
+ * the shared T2EX function of P1.1 (T2CON.EXEN2) undisturbed by SPI traffic.
+ *
+ * What is NOT modelled, and why, is recorded at the point of decision in
+ * rd2_spi.cc and summarised in /tmp/spi-report.md.  The two datasheet
+ * self-contradictions this block inherits are SPSTA's reset value (table 3-11 says
+ * 0000 0000b, table 16-4 says 00X0 XXXXb) and SPDAT's ("Indeterminate"), both of
+ * which cl_uc89c51rd2::clear_sfr() already resolves to 0x00; that choice is kept.
+ *
+ * Copyright (C) 2026 Oleksiy <alexian79@gmail.com>
+ * GPL-2.0-or-later
+ */
+
+#ifndef RD2_SPICCL_HEADER
+#define RD2_SPICCL_HEADER
+
+#include "hwcl.h"
+
+/* cl_hw ids in the HW_TIMER category are a bus other peripherals switch on
+   (serial.cc dispatches on 1, 2, 3 and 12; 10 is the ADC, 11 the STC watchdog,
+   12 the STC15 timer 2, 13 the internal BRG, **14 the keyboard** -- rd2_kbdcl.h
