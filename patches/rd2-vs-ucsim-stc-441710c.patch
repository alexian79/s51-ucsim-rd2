+ * and doc4235K table 17-1 (p.73) spells the four combinations out as 0 (lowest)
+ * to 3 (highest).  The pair is IPL0/IPH0 for INT0, T0, INT1, T1, the UART, T2 and
+ * the PCA (tables 17-4/17-5, pp.75-76); the keyboard and the SPI use IPL1/IPH1
+ * and get the same four levels there (tables 17-7/17-8, pp.78-79: KBDL/KBDH at
+ * bit 0, SPIL/SPIH at bit 2).  Bit 1 of both of those registers is Reserved: the
+ * name `TWIL' printed in the table 17-7 layout row is the only trace of a TWI
+ * peripheral in the whole of doc4235K and this part has none, so it is not
+ * decoded here.
+ *
+ * Two sources reach the pair-1 arm: the keyboard (rd2_kbd.cc, enable in IEN1 bit 0) and
+ * the SPI (rd2_spi.cc, two sources on IEN1 bit 2), both of which live outside IEN0 and
+ * therefore could not be built out of the existing rows (SIMULATION-PLAN.md 2.6).  KBD is
+ * bit 0 of IPL1/IPH1 and SPI is bit 2, so the same position does not identify the source
+ * and each source carries its own mask.  The pair stays inert for every source that does
+ * not declare IP_PAIR1 -- t/irctest.py pins that by loading both registers with 0xff and
+ * re-running the arbitration cases unchanged -- and both new sources override enabled(),
+ * because the base form ANDs the whole mask, pair flag included, with IEN1.
+ *
+ * Every other part served here has no IPH register to consult -- and the
+ * AT89C51RB2/RC2 is deliberately left on the one-bit answer so its transcripts
+ * stay byte-identical (t/ident89c51r.py) -- so they keep two levels.
+ */
 int
 cl_51core::priority_of(uchar nuof_it)
 {
-  if (sfr->get(IP) & /*ie_mask*/nuof_it)
-    return(1);
-  return(0);
+  uchar l, h;
+
+  if (!(type->type & CPU_89C51RD2))
+    {
+      if (sfr->get(IP) & /*ie_mask*/nuof_it)
+	return(1);
+      return(0);
+    }
+  if (nuof_it & IP_PAIR1)
+    {
+      /* IP_PAIR1 is a selector, not a bit of anything.  IPL1.7 and IPH1.7 are
+	 Reserved and read back whatever was written (tables 17-7/17-8, pp.78-79), so
+	 leaving the flag inside the mask would let `MOV IPL1,#0x80' hand a source
+	 level 1.  Stripping it is a no-op for every other source, since none of them
+	 carries the flag. */
+      l= sfr->get(IPL1) & (nuof_it & ~IP_PAIR1);
+      h= sfr->get(IPH1) & (nuof_it & ~IP_PAIR1);
+    }
+  else
+    {
+      l= sfr->get(IP) & nuof_it;
+      h= sfr->get(IPH) & nuof_it;
+    }
+  return((h ? 2 : 0) | (l ? 1 : 0));
 }
 
 
