+/*
+ * Expanded RAM of the AT89C51RD2/ED2 (doc4235 section 9).
+ *
+ * With AUXR.EXTRAM cleared, MOVX to 0x0000..(size-1) accesses on-chip RAM, where size
+ * comes from AUXR.XRS2:XRS0: 000=256, 001=512, 010=768 (reset), 011=1024, 100=1792.
+ * Above that size, or with EXTRAM set, MOVX goes off-chip.
+ *
+ * cl_uc51r::decode_xram only banks the low 256 bytes on EXTRAM alone, which is the Intel
+ * 51R rule, so it is replaced here instead of modified: 51R and 251 keep their mapping.
+ */
+bool
+cl_uc89c51r::rd2_mem(void)
+{
+  // cl_uc251 inherits this class; its XRAM rules are not the RD2's, and it carries
+  // neither of these bits.  Both the 89C51RB2/RC2 and the 89C51RD2/ED2 get the
+  // expanded-RAM window, X2 and the reset defaults; features that only the RD2 has
+  // must test CPU_89C51RD2 alone instead of widening this predicate.
+  return((type->type & (CPU_89C51R|CPU_89C51RD2)) != 0);
+}
+
+/*
+ * FCLK_PERIPH of doc4235 section 6, counted in machine cycles instead of hertz.
+ *
+ * FCLK_PERIPH is the post-prescaler oscillator clock the peripherals are divided from:
+ * Fosc/2 at reset in standard mode (CKRL=FFh) and Fosc with CKCON0.X2 set, while the
+ * machine cycle is Fosc/12 and Fosc/6 (section 7).  The two ratios are the same -- six
+ * FCLK_PERIPH periods per machine cycle in both clock states -- which is why the internal
+ * BRG needs no CKCON0 bit of its own and why doc4235 table 13-1 can state the PCA
+ * timebase as FCLK_PERIPH/6 = 1 count per machine cycle for either state.
+ */
+int
+cl_uc89c51r::fclk_periph_per_cycle(void)
+{
+  return 6;
+}
+
+
+/*
+ * The CKRL prescaler of doc4235 section 6 (printed pp.15-16).
+ *
+ * Figure 6-1 (printed p.16) and figure 7-1 (printed p.18) both put the 8-bit reload
+ * prescaler *ahead* of the /2-and-X2-mux stage, and section 6.2.1 writes its result as one
+ * equality, `FCLK_CPU = FCLK_PERIPH', so there is exactly one prescaled net: the machine
+ * cycle and the peripheral clock slow down together and their ratio never moves.  That is
+ * what makes the divisor a pure clock-domain quantity rather than a per-peripheral one:
+ * nothing that counts machine cycles has to know about it (timers 0/1/2, the PCA timebase,
+ * the watchdog, the internal BRG, the SPI bit rate and every instruction's cycle count are
+ * all machine-cycle derived and are left alone), and what does move is the value of a
+ * machine cycle in oscillator clocks, which is what clock_per_cycle() reports.
+ *
+ * Section 6.2.1 states the endpoints, and they fix the law: CKRL = FFh is `FCLK_CPU =
+ * FCLK_PERIPH = FOSC/2 (Standard Mode), FOSC (X2 Mode)', i.e. the bypass, and CKRL = 00h is
+ * `FOSC/1020 (Standard Mode) / FOSC/510 (X2 Mode)'.  Between them it gives, for CKRL <> FFh,
+ * `FOSC / (4 * (255 - CKRL))' in X1 and `FOSC / (2 * (255 - CKRL))' in X2.  Both are the
+ * bypass clock divided by 2*(255 - CKRL): 4*(255-CKRL) = 2 * 2*(255-CKRL) against the FOSC/2
+ * of Standard mode, and 2*(255-CKRL) against the FOSC of X2.  Hence M.
+ *
+ * CKRL = FFh must NOT be read as a divide by 255-255 = 0: it is a bypass (the datasheet says
+ * so explicitly and Table 6-1, printed p.15, resets the register to 1111 1111b, so the part
+ * comes up with M = 1 and every existing transcript is untouched).  At CKRL = 00h M is 510,
+ * i.e. the machine cycle costs 12*510 = 6120 oscillator clocks in Standard mode -- exactly
+ * the FOSC/1020 of section 6.2.1, since a machine cycle is 6 core clocks.
+ *
+ * Gated on CPU_89C51RD2 and not on rd2_mem(): Table 3-11 (printed p.7) does map 97h for the
+ * family, but this model leaves the 0x97 cell of the AT89C51RB2/RC2 unreset, so a family-wide
+ * reader would hand that part M = 510 out of reset and move its transcripts.  Widening it is
+ * a doc4316 question, exactly as for the sfr_tab51 name row in uc51.cc, which is gated the
+ * same way.
+ */
+int
+cl_uc89c51r::ckrl_divider(void)
+{
+  int ckrl;
+
+  if (!(type->type & CPU_89C51RD2))
+    return 1;
+  ckrl= sfr->read(CKRL) & 0xff;
+  if (ckrl == 0xff)
+    return 1;
+  return 2 * (255 - ckrl);
+}
+
+
+/*
+ * Clock control of the AT89C51RD2/ED2 (doc4235 sections 6 and 7).
+ *
+ * CKCON0.0 (X2) switches the CPU between 12 and 6 clock periods per machine cycle, and CKRL
+ * multiplies whatever it selects by M (see ckrl_divider()).  An instruction still retires in
+ * the same number of machine cycles either way -- sections 6.2.1 and 7.1 change what a cycle
+ * is *worth*, never how many a command costs -- so this only changes what a cycle is worth in
+ * clocks, which is exactly what clock_per_cycle() is for.  Because the multiplier is applied
+ * here, once, to a whole machine cycle, and M divides clock_per_cycle() by construction, no
+ * consumer ever sees a fraction: there is no per-call rounding anywhere in this path and
+ * therefore nothing that can drift.
+ *
+ * Each peripheral has its own CKCON0 bit that holds it at the standard 12 clock periods
+ * while the CPU runs at 6, and those bits have no effect at all in standard mode.  Measured
+ * against machine cycles a peripheral therefore never runs faster than one tick per cycle:
+ * it drops to a tick every two cycles only when X2 is on and its own bit asks for the
+ * standard speed.  Reset value is 0000 000'HSB.X2'b; the HSB is not modelled, so X2 starts
+ * cleared as the part does by default.
+ */
+int
+cl_uc89c51r::clock_per_cycle(void)
+{
+  int base;
+
+  if (!rd2_mem() || !(sfr->read(CKCON0) & bmX2))
+    base= cl_uc51r::clock_per_cycle();
+  else
+    base= 6;
+  return base * ckrl_divider();
+}
+
+
+int
+cl_uc89c51r::peripheral_cycles(int cycles, int x2_bit)
+{
+  int slot, b, total, ckcon0;
+
+  if (!rd2_mem() || x2_bit <= 0)
+    return cycles;
+  for (slot = 0, b = x2_bit; b > 1; b >>= 1)
+    slot++;
+  ckcon0 = sfr->read(CKCON0);
+  if (!(ckcon0 & bmX2) || !(ckcon0 & x2_bit))
+    {
+      // peripheral and CPU advance at the same rate, so no half cycle may survive a switch
+      x2_carry[slot] = 0;
+      return cycles;
+    }
+  total = cycles + x2_carry[slot];
+  x2_carry[slot] = total & 1;
+  return total >> 1;
+}
+
+
+void
+cl_uc89c51r::make_chips(void)
+{
+  cl_uc51r::make_chips();
+
+  if (!rd2_mem())
+    return;
+  eram1792_chip= new cl_chip8("eram1792_chip", 0x700, 8);
+  eram1792_chip->init();
+  memchips->add(eram1792_chip);
+}
+
+
+void
+cl_uc89c51r::decode_xram(void)
+{
+  if (!rd2_mem())
+    {
+      cl_uc51r::decode_xram();
+      return;
+    }
+  class cl_address_decoder *ad;
+  class cl_banker *b;
+  // XRS2:XRS0 -> bytes of on-chip RAM; 101..111 are undocumented, taken as the maximum
+  static const int xram_size[8]= {256, 512, 768, 1024, 1792, 1792, 1792, 1792};
+  int page, bank;
+
+  // beyond the largest possible selection the bus is always external
+  ad= new cl_address_decoder(xram, xram_chip, 0x700, 0xffff, 0x700);
+  ad->init();
+  xram->decoders->add(ad);
+  ad->activate(0);
+
+  for (page= 0; page < 7; page++)
+    {
+      t_addr base= page * 0x100;
+
+      // bank index: bit 0 = AUXR.EXTRAM, bits 1..3 = AUXR.XRS2:XRS0
+      b= new cl_banker(sfr, AUXR, bmEXTRAM, sfr, AUXR, bmXRS, 1,
+                       xram, base, base + 0xff);
+      b->init();
+      xram->decoders->add(b);
+      for (bank= 0; bank < 16; bank++)
+        {
+          if (((bank & 1) == 0) && (t_addr)xram_size[bank >> 1] > base)
+            b->add_bank(bank, eram1792_chip, base);
+          else
+            b->add_bank(bank, xram_chip, base);
+        }
+      b->activate(0);
+    }
+}
+
 void
 cl_uc89c51r::reset(void)
 {
   cl_uc51r::reset();
-  sfr->set(CCAPM0, sfr->get(CCAPM0) | bmECOM);
-  sfr->set(CCAPM1, sfr->get(CCAPM1) | bmECOM);
-  sfr->set(CCAPM2, sfr->get(CCAPM2) | bmECOM);
-  sfr->set(CCAPM3, sfr->get(CCAPM3) | bmECOM);
-  sfr->set(CCAPM4, sfr->get(CCAPM4) | bmECOM);
+  // doc4235 Table 3-11: CCAPMn resets to X000 0000b, so ECOM (bit 6) is clear and the
+  // PCA comparator leaves the CEX pins of P1 alone until software enables it.  The fork
+  // sets ECOM here for every part built on this class; that is kept for the 251, which
+  // derives from it, and skipped for the RD2.  write() rather than set(), because cl_pca
+  // caches CCAPMn in write() and set() never notifies it, so the 251 default would only
+  // reach the register and not the module that has to honour it.
+  if (!rd2_mem())
+    {
+      sfr->write(CCAPM0, sfr->get(CCAPM0) | bmECOM);
+      sfr->write(CCAPM1, sfr->get(CCAPM1) | bmECOM);
+      sfr->write(CCAPM2, sfr->get(CCAPM2) | bmECOM);
+      sfr->write(CCAPM3, sfr->get(CCAPM3) | bmECOM);
+      sfr->write(CCAPM4, sfr->get(CCAPM4) | bmECOM);
+    }
   sfr->write(IPH, 0);
+  // doc4235 Table 9-1: AUXR resets to 0X00 1000b, i.e. XRS=010 (768 bytes of on-chip
+  // expanded RAM, for T89C51RD2 compatibility) with EXTRAM cleared. cl_uc51r::reset
+  // zeroed it, which would select the 256-byte window.
+  if (rd2_mem()) sfr->write(AUXR, 0x08);
+  // doc4235 Table 7-1: CKCON0 resets to 0000 000'HSB.X2'b and the HSB is not modelled, so
+  // standard mode.  Any half machine cycle held back for a half-rate peripheral is void now.
+  if (rd2_mem()) sfr->write(CKCON0, 0);
+  for (int i= 0; i < 7; i++) x2_carry[i]= 0;
+}
+
+
+void
+cl_uc89c51r::clear_sfr(void)
+{
+  cl_uc51r::clear_sfr();
+  if (rd2_mem()) sfr->write(AUXR, 0x08);
+  if (rd2_mem()) sfr->write(CKCON0, 0);
+  for (int i= 0; i < 7; i++) x2_carry[i]= 0;
+}
+
+/*
+ * doc4235 Table 3-11 (pp. 8-9) reset values the AT89C51RB2/RC2 does not share, so
+ * they live here instead of in cl_uc89c51r::clear_sfr() and -t 89C51R still comes
+ * up with exactly the state it always did.  cl_51core::clear_sfr has already zeroed
+ * every SFR with set() -- which never notifies the peripheral that owns the cell --
+ * and has brought P0..P3 up at 0xff, so what happens below is (a) the registers that
+ * reset to something non-zero and (b) write() of the zero ones an owning peripheral
+ * caches, so the register and the cache cannot disagree after a reset.
+ *
+ * Bits the table leaves as X are brought up at 0.  Where the X is a reserved field
+ * (IEN1.7:3, IPL1.7:3, IPH1.7:3, FCON.7:4, BDRCON.7:5, the top bit of CCON and of
+ * each CCAPMn) 0 is what the rest of the part resets to and what a test bench
+ * expects to read.  Where an X selects behaviour it is the quieter reading: SPDAT
+ * reads 0 instead of a random byte, and CCAPMn with ECOM clear leaves the CEX pins
+ * alone (that one is not an X, the table says X000 0000b).
+ */
+void
+cl_uc89c51rd2::clear_sfr(void)
+{
+  cl_uc89c51r::clear_sfr();
+  // Ports with pull-ups, like P0..P3: 1111 1111b at reset.  0xe8 and 0xc7 are two
+  // addresses of the P5 latch (Table 3-10); the model keeps separate cells for them,
+  // as it already does for the 89C51R's P4, so both are brought up here -- a write to
+  // one still does not follow the other, which is a gap this commit does not close.
+  sfr->write(RD2_P4, 0xff);
+  sfr->write(RD2_P5, 0xff);
+  sfr->write(RD2_P5_BIT, 0xff);
+  // ClocK ReLoad: 1111 1111b is the documented prescaler bypass (doc4235 section 7).
+  // The divider itself is not modelled, so this only keeps the register honest.
+  sfr->write(CKRL, 0xff);
+  // SPI control: 0001 0100b, i.e. SSDIS=1 and CPHA=1 while SPEN keeps it disabled.
+  sfr->write(SPCON, 0x14);
+  sfr->write(SPSTA, 0x00);   // 0000 0000b here, 00X0 XXXXb in Table 16-4
+  sfr->write(SPDAT, 0x00);   // "indeterminate" in the datasheet; 0 is the quiet choice
+  // PCA: CCON 00X0 0000b (CF, CR and CCFn clear), CMOD 00XX X000b (CIDL and WDTE
+  // clear, so the module-4 watchdog does not reset the chip on its own), CCAPMn
+  // X000 0000b.  cl_pca caches all three and set() does not notify it, so write() is
+  // what pins its caches to the reset state.
+  sfr->write(CCON, 0x00);
+  sfr->write(CMOD, 0x00);
+  sfr->write(CCAPM0, 0x00);
+  sfr->write(CCAPM1, 0x00);
+  sfr->write(CCAPM2, 0x00);
+  sfr->write(CCAPM3, 0x00);
+  sfr->write(CCAPM4, 0x00);
+  // T2MOD XXXX XX00b: T2OE (bit 1) clear, so P1.0 is not a clock output after reset;
+  // timer2.cc caches bit_t2oe from its T2MOD hook, so it has to hear about this.
+  sfr->write(T2MOD, 0x00);
+  // BDRCON XXX0 0000b: BRR clear stops the baud rate generator; BRL 0000 0000b is the
+  // slowest reload (256 counts).
+  sfr->write(BDRCON, 0x00);
+  sfr->write(BRL, 0x00);
+  // IEN1 / IPL1 / IPH1 XXXX X000b: ESPI, KBD, SPIL, SPIH, KBDL and KBDH clear.
+  sfr->write(IEN1, 0x00);
+  sfr->write(IPL1, 0x00);
+  sfr->write(IPH1, 0x00);
+  // KBLS 0000 0000b: every key senses a low level.  KBE 0000 0000b: no key can
+  // request the interrupt.  KBF reads 0000 0000b (it is read-only hardware state).
+  sfr->write(KBLS, 0x00);
+  sfr->write(KBE, 0x00);
+  sfr->write(KBF, 0x00);
+  // WDTPRG XXXX X000b: S2:S0 = 000, the base 2^14 machine-cycle period.
+  sfr->write(WDTPRG, 0x00);
+  // FCON XXXX 0000b: bits 3:0 read 0, bits 7:4 have no documented function.
+  sfr->write(FCON, 0x00);
+  // EECON xxxx xx00b (table 3-11, printed p.7): EEE clear selects the plain XRAM map, EEBUSY
+  // clear says no EEPROM program cycle is running.  Naming it is what makes `dump sfr[0xd2]` agree
+  // with that table; it is NOT a claim that the remap exists.  The array behind EEE is AT89C51ED2
+  // only -- "On-chip 2048 Bytes EEPROM Block for Data Storage (AT89C51ED2 Only)", printed p.1 --
+  // so on this part writing EEE must leave every MOVX target alone, and t/rd2registers.py pins
+  // exactly that.  The remap itself belongs to a future -t 89C51ED2 (SIMULATION-PLAN.md Phase 7),
+  // which is also why no bit_t/EEE hook appears here.
+  // AUXR1 0XXX X0X0b: everything reads 0, which selects DPTR0.
+  sfr->write(AUXR1, 0x00);
+  // PCON 00X1 0000b (table 21-1, printed p.87; same in table 6-2, printed p.15, and in the family
+  // map table 3-11, printed p.7): POF (bit 4) is "set by hardware when VCC rises from 0 to its
+  // nominal voltage", so it is 1 out of reset, and "cleared by software to recognize the next reset
+  // type" -- a plain read/write bit, hence no hook.  Bit 5 is Reserved and reads indeterminate; the
+  // model leaves it 0.  This is written here rather than at the family `sfr->write(PCON, 0)` in
+  // cl_uc51 so that `dump sfr` on the AT89C51RB2/RC2 keeps its transcript (SIMULATION-PLAN.md 1.1);
+  // whether those parts also set POF is a doc4316 question, not a doc4235 one.
+  sfr->write(PCON, bmPOF);
+}
+
+/*
+ * Is this the AT89C51ED2 rather than the AT89C51RD2?  doc4235 gives the pair one machine and
+ * exactly one difference -- "This feature is available only for the AT89C51ED2 device"
+ * (section 23, printed p.89) -- so the split has to live somewhere.  It cannot live in the cpu
+ * flag: cl_sim51::mk_controller (sim51.cc:91) switches on the *exact* value of the device-table
+ * row, so a combined CPU_89C51RD2|CPU_89C51ED2 row would fall through to "Unknown processor
+ * type" unless sim51.cc gained a case label and globals.cc a cast to the enum, while a
+ * *separate* bit for the ED2 would take it out of every `type & CPU_89C51RD2` test in this
+ * model and strip it of the XRAM window, X2, the CKRL prescaler, the SPI, the keyboard, the
+ * BRG, the boot ROM and its SFR names -- all of which the ED2 has, and which SIMULATION-PLAN.md
+ * Phase 7 says it must share.  So both names stay one flag (globals.cc:385-386, the rows this
+ * reads) and the difference is taken on the row the name resolved to.  type_str is the table's
+ * own spelling, not the user's typing -- mk_controller has already matched -t with strcasecmp
+ * and hands over &cpus_51[i] -- so plain strcmp is exact here.  Anyone moving this to a flag
+ * must widen mk_controller with it; nothing else in the model may key on the name.
+ */
+static bool
+rd2_is_ed2(struct cpu_entry *ent)
+{
+  return(ent != 0 && (ent->type & CPU_89C51RD2) != 0 &&
+	 strcmp(ent->type_str, "89C51ED2") == 0);
+}
+
+/*
+ * The peripherals this part has and the family class does not: the internal baud rate
+ * generator of the enhanced UART (doc4235 figure 14-5, tables 14-12/14-13), the keyboard
+ * interface (section 15, printed pp.59-62), the SPI module (section 16, printed
+ * pp.63-71), the boot ROM with its Flash API (section 24, printed pp.92-113) and the
+ * 2048-byte data EEPROM of section 23 (printed pp.89-92), which of the pair only the
+ * AT89C51ED2 has.  All of them are registered here rather than gated inside
+ * cl_uc89c51r::mk_hw_elements(), exactly as the class comment above promises, because that
+ * function is shared with the AT89C51RB2/RC2, which has none of them: an add_hw() there
+ * would give that part a `brg`, a `kbd`, a `spi`, a `boot` and an `eeprom`, and with the
+ * keyboard and the SPI, interrupt sources aimed at vectors 003Bh and 004Bh that do not
+ * exist on it.
+ * Only the EEPROM needs a predicate of its own (rd2_is_ed2 below), and it needs one because
+ * doc4235 splits the pair on that feature alone while the device table gives both names the
+ * same cpu flag; the other four are the RD2 feature set as a whole and appear on the ED2
+ * exactly as they do on the RD2.
+ * cl_serial picks the BRG up through new_hw_added(); the keyboard and the SPI each
+ * build their own cl_it_srcs
+ * from added_to_uc(), which add_hw() is what runs, so the family class needs no predicate
+ * for any of them.  The SPI needs none of its own either: its three SFRs are already named
+ * for the console by sfr_tab51 (uc51.cc, gated on CPU_89C51RD2) and already reset by
+ * clear_sfr() above, and it reads CKCON1 and drives four pins of the Port 1 latch that
+ * cl_51core built.
+ */
+void
+cl_uc89c51rd2::mk_hw_elements(void)
+{
+  class cl_hw *h;
+
+  cl_uc89c51r::mk_hw_elements();
+  add_hw(h= new cl_rd2_brg(this));
+  h->init();
+  add_hw(h= new cl_rd2_kbd(this));
+  h->init();
+  add_hw(h= new cl_rd2_spi(this));
+  h->init();
+  // The boot ROM is not a peripheral in the clocked sense -- no pin, no clock, no
+  // interrupt -- but the ENBOOT window it installs and the array its API programs are
+  // the address spaces and chips make_memories() has already built, which is exactly
+  // when mk_hw_elements() runs.  Keeping it an element here rather than a decode_rom()
+  // override in the family class is what leaves the AT89C51RB2/RC2 the flat 64K mapping
+  // it has always had.
+  add_hw(h= new cl_rd2_boot(this));
+  h->init();
+  boot_hw= (class cl_rd2_boot *)h;
+  // The data EEPROM, and the only element in this file behind a device-name test: see
+  // rd2_is_ed2() for why the cpu flag cannot carry the RD2/ED2 split.  Nothing else may sit
+  // inside it -- an `eeprom` element on the plain RD2 would contradict D14 and
+  // t/xramtest.py::eecon_does_not_remap, which pin EECON as named-but-inert there.
+  if (rd2_is_ed2(type))
+    {
+      add_hw(h= new cl_rd2_eeprom(this));
+      h->init();
+    }
+}
+
+/*
+ * USER_CALL, the one entry point of the Flash API: "All calls are made through a common
+ * interface USER_CALL at the address FFF0h" (doc4235 section 24.10.1, printed p.112).
+ *
+ * The entry has to be noticed here, on the instruction boundary, rather than by hooking
+ * the read of the cell at FFF0h: the core fetches that byte in order to execute it, so a
+ * read hook would run the API on a console `dump code` as well, and on any MOVC of the
+ * vector, and a flash array that answers a read by erasing blocks is not a memory.
+ * Looking at the PC means the interception happens exactly when the part would have run
+ * the boot ROM's first instruction.
+ *
+ * With ENBOOT set the ROM is mapped (table 8-1, printed p.21) and the API runs natively;
+ * the API's own return is the RET the caller relied on ("The jump at the USER_CALL must
+ * be done by LCALL instruction to be able to comeback in the application", printed
+ * p.112), so instruction_22 performs it and costs what a real RET costs.  With ENBOOT
+ * clear there is no ROM at FFF0h to enter, and the honest model of the part is the one
+ * the datasheet implies: the byte the flash array holds at FFF0h is fetched and executed
+ * after the call has been named and counted as refused (rd2_boot.cc).  Accepting the
+ * call silently would let an application that forgot ENBOOT pass a test of the API.
+ *
+ * The interrupts are deliberately left alone: "The interrupts are not disabled by the
+ * bootloader.  Interrupts must be disabled by user prior to jump to the USER_CALL"
+ * (section 24.10.2, printed p.112), so an API call taken with IE still open is modelled
+ * as exactly that -- an interrupt can be taken between the API and the RET.
+ */
+int
+cl_uc89c51rd2::exec_inst(void)
+{
+  if (boot_hw && PC == cl_rd2_boot::entry_addr)
+    {
+      if (boot_hw->enabled())
+        {
+          // cl_51core::do_inst (uc51.cc) never assigns instPC, so it still holds whatever
+          // the last do_emu left in it; the RET's stack record should name the entry point
+          // this call returns from, and nothing else reads instPC on this path.
+          instPC= PC;
+          boot_hw->user_call();
+          return instruction_22(0x22);
+        }
+      boot_hw->refuse();
+    }
+  return cl_uc89c51r::exec_inst();
 }
 
 int
